provider openai {
    driver: "openai"
    endpoint: "https://api.openai.com/v1"
    api_key: secrets.api_key
    models: ["gpt-4.1-mini"]
}

secrets {
    api_key: string
}

input {
    topic: string
}

agent brief_writer {
    model: openai("gpt-4.1-mini")
    prompt: "Write a short brief about {{ input.topic }}"
    output: string
}

output {
    brief: agent.brief_writer
}
