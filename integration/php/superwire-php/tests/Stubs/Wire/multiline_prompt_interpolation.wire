provider openai {
    driver: "openai"
    endpoint: "https://api.openai.com/v1"
    api_key: "local-test-key"
    models: ["gpt-4.1-mini"]
}

input {
    product_name: string
}

agent draft {
    model: openai("gpt-4.1-mini")
    prompt: "Draft for {{ input.product_name }}"
    output: {
        text: string
    }
}

agent final_message {
    model: openai("gpt-4.1-mini")
    prompt: """
        Product: {{ input.product_name }}
        Draft: {{ agent.draft.text }}
        Keep concise.
    """
    output: {
        body: string
    }
}

output {
    body: agent.final_message.body
}
