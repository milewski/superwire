provider openai {
    driver: "openai"
    endpoint: "https://api.openai.com/v1"
    api_key: "local-test-key"
    models: ["gpt-4.1-mini"]
}

agent typed_example {
    model: openai("gpt-4.1-mini")
    prompt: "Return all fields with matching types"
    output: {
        string_value: string
        number_value: number
        float_value: float
        boolean_value: boolean
        explicit_null: null
        nullable_string: string | null
        array_value: [string]
        fixed_array: [string; 2]
        enum_value: "draft" | "ready"
        tuple_value: (string, number)
        object_value: {
            nested_string: string
            nested_number: number
        }
    }
}

output {
    result: agent.typed_example
}
