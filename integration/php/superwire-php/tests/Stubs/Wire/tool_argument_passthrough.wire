provider openai {
    driver: "openai"
    endpoint: "http://localhost:1234/v1"
    api_key: "local-test-key"
}

input {
    workspace_id: number
    record_id: number
    actor_id: number
}

agent action_summary {
    model: openai("gpt-4.1-mini")
    tools: [
        tool.fetch_record_action(workspace_id: input.workspace_id, record_id: input.record_id),
    ]
    prompt: "Call fetch_record_action exactly once with actor_id = {{ input.actor_id }}"
    output: {
        actor_id: number
        summary: string
    }
}

output {
    actor_id: agent.action_summary.actor_id
    summary: agent.action_summary.summary
}
