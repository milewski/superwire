provider openai {
    driver: "openai"
    endpoint: "https://api.openai.com/v1"
    api_key: "local-test-key"
    models: ["gpt-4.1-mini"]
}

input {
    topic: string
}

agent source {
    model: openai("gpt-4.1-mini")
    prompt: "Build source token for {{ input.topic }}"
    output: {
        token: string
    }
}

agent consumer {
    model: openai("gpt-4.1-mini")
    tools: [
        tool.audit_lookup(seed: agent.source.token)
    ]
    prompt: "Use the audit tool"
    output: {
        value: string
    }
}

output {
    value: agent.consumer.value
}
