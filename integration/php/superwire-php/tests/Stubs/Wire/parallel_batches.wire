provider openai {
    driver: "openai"
    endpoint: "https://api.openai.com/v1"
    api_key: "local-test-key"
    models: ["gpt-4.1-mini"]
}

input {
    topic: string
}

agent alpha {
    model: openai("gpt-4.1-mini")
    prompt: "Write alpha for {{ input.topic }}"
    output: {
        value: string
    }
}

agent beta {
    model: openai("gpt-4.1-mini")
    prompt: "Write beta for {{ input.topic }}"
    output: {
        value: string
    }
}

agent gamma {
    model: openai("gpt-4.1-mini")
    prompt: "Write gamma for {{ input.topic }}"
    output: {
        value: string
    }
}

agent review {
    model: openai("gpt-4.1-mini")
    prompt: "Review {{ agent.alpha.value }}, {{ agent.beta.value }}, {{ agent.gamma.value }}"
    output: {
        ok: boolean
    }
}

output {
    ok: agent.review.ok
}
