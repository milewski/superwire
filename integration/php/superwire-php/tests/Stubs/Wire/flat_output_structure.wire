provider openai {
    driver: "openai"
    endpoint: "https://api.openai.com/v1"
    api_key: "local-test-key"
    models: ["gpt-4.1-mini"]
}

agent summary {
    model: openai("gpt-4.1-mini")
    prompt: "Write summary"
    output: {
        text: string
    }
}

output {
    version: 1
    source: "flat"
    text: agent.summary.text
}
