provider openai {
    driver: "openai"
    endpoint: "https://api.openai.com/v1"
    api_key: "local-test-key"
    models: ["gpt-4.1-mini"]
}

secrets {
    token: string
}

input {
    question: string
}

agent helper {
    model: openai("gpt-4.1-mini")
    tools: [
        tool.web_search,
        tool.secure_lookup(token: secrets.token),
        tool.filter_lookup(query: input.question, limit: 5),
    ]
    prompt: "Answer {{ input.question }}"
    output: {
        answer: string
    }
}

output {
    answer: agent.helper.answer
}
