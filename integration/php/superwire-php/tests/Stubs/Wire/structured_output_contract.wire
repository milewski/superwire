provider openai {
    driver: "openai"
    endpoint: "https://api.openai.com/v1"
    api_key: "local-test-key"
    models: ["gpt-4.1-mini"]
}

agent summary {
    model: openai("gpt-4.1-mini")
    prompt: "Write summary and confidence"
    output: {
        text: string
        confidence: number
    }
}

output {
    version: 2
    report: {
        overview: { text: agent.summary.text }
        metrics: {
            confidence: agent.summary.confidence
            status: "ok"
        }
    }
}
