{
    "name": "superwire/superwire-php",
    "description": "Core contracts and helpers for executing Superwire workflow JSON.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "swaggest/json-schema": "^0.12.43"
    },
    "require-dev": {
        "opis/json-schema": "^2.6",
        "phpunit/phpunit": "^12.0",
        "symfony/var-dumper": "^7.4"
    },
    "autoload": {
        "psr-4": {
            "Superwire\\Contracts\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Superwire\\Contracts\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
