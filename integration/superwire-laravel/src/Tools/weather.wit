package superwire:tool@0.1.0;

/// @tool-name weather
/// @tool-description Fetches weather summary via wttr.in in Laravel runtime.

interface schema {
  /// Agent-provided weather request payload.
  record agent-input {
    /// Optional city requested by the model.
    city: option<string>,
  }

  /// Workflow-bound weather request payload.
  record bound-input {
    /// Optional city provided through workflow bindings.
    city: option<string>,
  }

  /// Weather response payload.
  record output {
    /// City resolved by the tool.
    city: string,

    /// Weather summary returned from wttr.in.
    summary: string,

    /// Source attribution.
    source: string,
  }
}

world tool-schema {
  import schema;
}
