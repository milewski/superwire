{
    "name": "superwire/superwire-laravel",
    "description": "Laravel integration package for Superwire workflows and PHP-backed WASM tools",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "illuminate/console": "^11.0|^12.0",
        "illuminate/routing": "^11.0|^12.0",
        "illuminate/support": "^11.0|^12.0",
        "swaggest/json-schema": "^0.12",
        "symfony/process": "^7.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0"
    },
    "autoload": {
        "psr-4": {
            "Superwire\\Laravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Superwire\\Laravel\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Superwire\\Laravel\\SuperwireServiceProvider"
            ]
        }
    }
}
