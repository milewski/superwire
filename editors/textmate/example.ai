// Example AI Engine DSL file demonstrating all syntax features
// This file showcases the TextMate grammar highlighting with enhanced colors

/* Block comment example
   Multiple lines supported */

// Provider configuration - note the colored braces, keywords, and operators
provider ollama1 {
    driver <- "ollama"
    api_endpoint <- "http://100.76.5.36:11434"
    models <- ["qwen3.5:27b", "qwen3.5:35b"]
}

provider ollama2 {
    driver <- "ollama"
    api_endpoint <- "http://localhost:11434"
    models <- ["llama3:8b"]
}

// Schema with all supported types - note colored colons, pipes, and brackets
schema person {
    name: string "Full name in format: first_name last_name"
    age: number "Age in years"
    email: string | null "Optional email address"
    is_active: boolean
    gender: "male" | "female" | "other"
    hobbies: [string] "List of hobbies"
    scores: [number]
}

// Schema with nested types
schema product {
    name: string
    price: number
    category: "electronics" | "books" | "clothing"
    tags: [string]
    in_stock: boolean
}

// Agent with inline schema - note the colored braces
agent generate_person {
    model <- "ollama1/qwen3.5:27b"
    output <- schema {
        name: string
        age: number
    }
    prompt <- """
        Generate a fictional person.
        Return ONLY a JSON object with name (string) and age (number).
    """
}

// Agent with schema reference - note the colored dot accessor
agent validate_person {
    model <- "ollama1/qwen3.5:27b"
    output <- schema.person
    prompt <- "Create a complete person profile"
}

// Agent with template variables - note {{ }} delimiters and variable names
agent greet_person {
    model <- "ollama1/qwen3.5:27b"
    prompt <- """
        Write a friendly greeting for {{ generate_person.name }}
        who is {{ generate_person.age }} years old.
        Keep it to one sentence.
    """
}

// Agent with context reference - note the colored dots
agent summarize {
    model <- "ollama2/llama3:8b"
    context <- greet_person.context
    prompt <- "Summarize the conversation"
}

// Agent with context summary - note multiple dot accessors
agent brief_summary {
    model <- "ollama1/qwen3.5:27b"
    context <- greet_person.context.summary
    prompt <- "Create a brief summary"
}

// Agent with for_each - note the colored brackets, commas, and 'as' keyword
agent iterate_numbers {
    for_each <- [1, 2, 3, 4, 5] as number

    output <- schema {
        value: number
        squared: number
    }

    prompt <- """
        Calculate {{ number }} squared.
    """
}

// Agent with for_each using agent reference
agent process_hobbies {
    for_each <- validate_person.hobbies as hobby

    output <- schema {
        hobby_name: string
        activities: [string]
    }

    prompt <- """
        For the hobby {{ hobby }}, list 3 related activities.
    """
}

// Agent with file function - note the colored braces and nested structure
agent templated_prompt {
    model <- "ollama1/qwen3.5:27b"
    prompt <- file "./templates/prompt.md" {
        role <- "assistant"
        task <- "explain concepts"
        context <- "teaching programming"
    }
}

// Agent with nested file functions
agent complex_template {
    model <- "ollama1/qwen3.5:27b"
    prompt <- file "./templates/main.md" {
        header <- file "./templates/header.md" {
            title <- "Welcome"
        }
        content <- "Main content here"
    }
}

// Agent with tools array - note the colored brackets and commas
agent tool_user {
    model <- "ollama1/qwen3.5:27b"
    tools <- ["calculator", "web_search", "file_reader"]
    prompt <- "Use tools to solve the problem"
}

// Terminal agent (single output) - note the <- prefix
<- agent final_output {
    model <- "ollama1/qwen3.5:27b"
    prompt <- "Generate final result"
}

// Multiple terminal agents
<- agent result_one {
    model <- "ollama1/qwen3.5:27b"
    prompt <- "First result"
}

<- agent result_two {
    model <- "ollama2/llama3:8b"
    prompt <- "Second result"
}

// Complex for_each with array literal - all elements should be colored
agent complex_iteration {
    for_each <- [10, 20, 30, 40, 50] as value

    output <- schema {
        original: number
        doubled: number
        tripled: number
    }

    prompt <- """
        Calculate {{ value }} * 2 and {{ value }} * 3.
    """
}
