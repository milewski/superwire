{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "AI Engine DSL",
  "scopeName": "source.ai",
  "patterns": [
    { "include": "#comments" },
    { "include": "#provider-block" },
    { "include": "#schema-block" },
    { "include": "#agent-block" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.ai",
          "match": "//.*$"
        },
        {
          "name": "comment.block.ai",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "provider-block": {
      "begin": "\\b(provider)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\s*(\\{)",
      "beginCaptures": {
        "1": { "name": "keyword.control.ai" },
        "2": { "name": "entity.name.type.provider.ai" },
        "3": { "name": "punctuation.definition.block.ai" }
      },
      "end": "(\\})",
      "endCaptures": {
        "1": { "name": "punctuation.definition.block.ai" }
      },
      "patterns": [
        { "include": "#comments" },
        { "include": "#provider-properties" }
      ]
    },
    "provider-properties": {
      "patterns": [
        {
          "match": "\\b(driver|api_endpoint|models)\\s*(<-)\\s*",
          "captures": {
            "1": { "name": "variable.parameter.ai" },
            "2": { "name": "keyword.operator.assignment.ai" }
          }
        },
        { "include": "#string" },
        { "include": "#array" }
      ]
    },
    "schema-block": {
      "begin": "\\b(schema)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\s*(\\{)",
      "beginCaptures": {
        "1": { "name": "keyword.control.ai" },
        "2": { "name": "entity.name.type.schema.ai" },
        "3": { "name": "punctuation.definition.block.ai" }
      },
      "end": "(\\})",
      "endCaptures": {
        "1": { "name": "punctuation.definition.block.ai" }
      },
      "patterns": [
        { "include": "#comments" },
        { "include": "#schema-field" }
      ]
    },
    "schema-field": {
      "patterns": [
        {
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(:)\\s*",
          "captures": {
            "1": { "name": "variable.other.property.ai" },
            "2": { "name": "punctuation.separator.type.ai" }
          }
        },
        { "include": "#string" },
        { "include": "#schema-type" }
      ]
    },
    "schema-type": {
      "patterns": [
        {
          "name": "storage.type.primitive.ai",
          "match": "\\b(string|number|boolean|null)\\b"
        },
        {
          "name": "storage.type.array.ai",
          "match": "\\[\\s*(string|number|boolean)\\s*\\]"
        },
        {
          "name": "keyword.operator.logical.ai",
          "match": "\\|"
        }
      ]
    },
    "agent-block": {
      "begin": "(<-)?\\s*\\b(agent)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\s*(\\{)",
      "beginCaptures": {
        "1": { "name": "keyword.operator.terminal.ai" },
        "2": { "name": "keyword.control.ai" },
        "3": { "name": "entity.name.function.agent.ai" },
        "4": { "name": "punctuation.definition.block.ai" }
      },
      "end": "(\\})",
      "endCaptures": {
        "1": { "name": "punctuation.definition.block.ai" }
      },
      "patterns": [
        { "include": "#comments" },
        { "include": "#agent-properties" }
      ]
    },
    "agent-properties": {
      "patterns": [
        { "include": "#for-each-property" },
        {
          "match": "\\b(model|tools|context|output|prompt)\\s*(<-)\\s*",
          "captures": {
            "1": { "name": "variable.parameter.ai" },
            "2": { "name": "keyword.operator.assignment.ai" }
          }
        },
        { "include": "#schema-reference" },
        { "include": "#inline-schema" },
        { "include": "#function-call" },
        { "include": "#multiline-string" },
        { "include": "#string" },
        { "include": "#array" },
        { "include": "#agent-reference" }
      ]
    },
    "for-each-property": {
      "begin": "\\b(for_each)\\s*(<-)\\s*",
      "beginCaptures": {
        "1": { "name": "variable.parameter.ai" },
        "2": { "name": "keyword.operator.assignment.ai" }
      },
      "end": "(?=\\n|$)",
      "patterns": [
        { "include": "#for-each-as-clause" },
        { "include": "#agent-reference" },
        { "include": "#array" }
      ]
    },
    "for-each-as-clause": {
      "match": "\\b(as)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
      "captures": {
        "1": { "name": "keyword.control.ai" },
        "2": { "name": "variable.other.readwrite.ai" }
      }
    },
    "schema-reference": {
      "match": "\\b(schema)(\\.)([a-zA-Z_][a-zA-Z0-9_]*)",
      "captures": {
        "1": { "name": "keyword.control.ai" },
        "2": { "name": "punctuation.accessor.ai" },
        "3": { "name": "entity.name.type.schema.ai" }
      }
    },
    "inline-schema": {
      "begin": "\\b(schema)\\s*(\\{)",
      "beginCaptures": {
        "1": { "name": "keyword.control.ai" },
        "2": { "name": "punctuation.definition.block.ai" }
      },
      "end": "(\\})",
      "endCaptures": {
        "1": { "name": "punctuation.definition.block.ai" }
      },
      "patterns": [
        { "include": "#comments" },
        { "include": "#schema-field" }
      ]
    },
    "function-call": {
      "begin": "\\b(file)\\s+(\"[^\"]*\")\\s*(\\{)",
      "beginCaptures": {
        "1": { "name": "entity.name.function.ai" },
        "2": { "name": "string.quoted.double.ai" },
        "3": { "name": "punctuation.definition.block.ai" }
      },
      "end": "(\\})",
      "endCaptures": {
        "1": { "name": "punctuation.definition.block.ai" }
      },
      "patterns": [
        { "include": "#comments" },
        { "include": "#function-arguments" }
      ]
    },
    "function-arguments": {
      "patterns": [
        {
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(<-)\\s*",
          "captures": {
            "1": { "name": "variable.parameter.ai" },
            "2": { "name": "keyword.operator.assignment.ai" }
          }
        },
        { "include": "#function-call" },
        { "include": "#multiline-string" },
        { "include": "#string" }
      ]
    },
    "agent-reference": {
      "patterns": [
        {
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)(\\.)([a-zA-Z_][a-zA-Z0-9_]*)(\\.)([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "entity.name.function.agent.ai" },
            "2": { "name": "punctuation.accessor.ai" },
            "3": { "name": "variable.other.property.ai" },
            "4": { "name": "punctuation.accessor.ai" },
            "5": { "name": "variable.other.property.ai" }
          }
        },
        {
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)(\\.)([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "entity.name.function.agent.ai" },
            "2": { "name": "punctuation.accessor.ai" },
            "3": { "name": "variable.other.property.ai" }
          }
        }
      ]
    },
    "template-variable": {
      "begin": "(\\{\\{)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.template.begin.ai" }
      },
      "end": "(\\}\\})",
      "endCaptures": {
        "1": { "name": "punctuation.definition.template.end.ai" }
      },
      "contentName": "meta.template.expression.ai",
      "patterns": [
        {
          "match": "\\s*([a-zA-Z_][a-zA-Z0-9_]*)(\\.([a-zA-Z_][a-zA-Z0-9_]*))*\\s*",
          "captures": {
            "1": { "name": "variable.other.readwrite.ai" },
            "3": { "name": "variable.other.property.ai" }
          }
        }
      ]
    },
    "multiline-string": {
      "name": "string.quoted.triple.ai",
      "begin": "\"\"\"",
      "end": "\"\"\"",
      "patterns": [
        { "include": "#template-variable" }
      ]
    },
    "string": {
      "patterns": [
        {
          "name": "string.quoted.double.ai",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.ai",
              "match": "\\\\."
            },
            { "include": "#template-variable" }
          ]
        }
      ]
    },
    "array": {
      "begin": "\\[",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.array.begin.ai" }
      },
      "end": "\\]",
      "endCaptures": {
        "0": { "name": "punctuation.definition.array.end.ai" }
      },
      "patterns": [
        { "include": "#comments" },
        { "include": "#string" },
        { "include": "#number" },
        { "include": "#boolean" },
        {
          "name": "punctuation.separator.array.ai",
          "match": ","
        }
      ]
    },
    "number": {
      "name": "constant.numeric.ai",
      "match": "\\b\\d+(\\.\\d+)?\\b"
    },
    "boolean": {
      "name": "constant.language.boolean.ai",
      "match": "\\b(true|false)\\b"
    }
  }
}
