{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Superwire DSL",
  "scopeName": "source.wire",
  "fileTypes": [
    "wire"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#declarations"
    },
    {
      "include": "#expressions"
    }
  ],
  "repository": {
    "language-keywords": {
      "patterns": [
        {
          "name": "keyword.control.wire",
          "match": "(?<![.#-])\\b(provider|model|mcp|secrets|input|schema|tool|resource|prompt|from|dynamic|agent|file|for|in|output|as|call|read|render|match|asset|compact|context)\\b(?![.#-])"
        }
      ]
    },
    "type-keywords": {
      "patterns": [
        {
          "name": "storage.type.wire",
          "match": "\\b(string|number|float|boolean|object|maybe|enum|variant)\\b"
        }
      ]
    },
    "literal-keywords": {
      "patterns": [
        {
          "name": "constant.language.boolean.wire",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.language.null.wire",
          "match": "\\bnull\\b"
        }
      ]
    },
    "comments": {
      "patterns": [
        {
          "name": "comment.line.documentation.wire",
          "match": "///.*$"
        },
        {
          "name": "comment.line.double-slash.wire",
          "match": "//.*$"
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "include": "#provider-declaration"
        },
        {
          "include": "#model-declaration"
        },
        {
          "include": "#mcp-declaration"
        },
        {
          "include": "#secrets-declaration"
        },
        {
          "include": "#input-declaration"
        },
        {
          "include": "#schema-declaration"
        },
        {
          "include": "#mcp-batch-import-declaration"
        },
        {
          "include": "#mcp-import-declaration"
        },
        {
          "include": "#tool-declaration"
        },
        {
          "include": "#dynamic-declaration"
        },
        {
          "include": "#agent-declaration"
        },
        {
          "include": "#output-declaration"
        }
      ]
    },
    "provider-declaration": {
      "begin": "\\b(provider)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s+(from)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*(\\{)",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.declaration.provider.wire"
        },
        "2": {
          "name": "entity.name.type.provider.wire"
        },
        "3": {
          "name": "keyword.control.import.from.wire"
        },
        "4": {
          "name": "entity.name.namespace.provider-source.wire"
        },
        "5": {
          "name": "punctuation.section.block.begin.wire"
        }
      },
      "end": "\\}",
      "endCaptures": {
        "0": {
          "name": "punctuation.section.block.end.wire"
        }
      },
      "patterns": [
        {
          "include": "#inference-block"
        },
        {
          "include": "#object-fields"
        }
      ]
    },
    "model-declaration": {
      "begin": "\\b(model)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s+(from)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*(\\{)",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.declaration.model.wire"
        },
        "2": {
          "name": "entity.name.type.model.wire"
        },
        "3": {
          "name": "keyword.control.import.from.wire"
        },
        "4": {
          "name": "entity.name.type.provider.wire"
        },
        "5": {
          "name": "punctuation.section.block.begin.wire"
        }
      },
      "end": "\\}",
      "endCaptures": {
        "0": {
          "name": "punctuation.section.block.end.wire"
        }
      },
      "patterns": [
        {
          "include": "#named-object-property"
        },
        {
          "include": "#object-fields"
        }
      ]
    },
    "mcp-declaration": {
      "begin": "\\b(mcp)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*(\\{)",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.declaration.mcp.wire"
        },
        "2": {
          "name": "entity.name.namespace.mcp.wire"
        },
        "3": {
          "name": "punctuation.section.block.begin.wire"
        }
      },
      "end": "\\}",
      "endCaptures": {
        "0": {
          "name": "punctuation.section.block.end.wire"
        }
      },
      "patterns": [
        {
          "include": "#named-object-property"
        },
        {
          "include": "#object-fields"
        }
      ]
    },
    "secrets-declaration": {
      "begin": "\\b(secrets)\\s*(\\{)",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.declaration.secrets.wire"
        },
        "2": {
          "name": "punctuation.section.block.begin.wire"
        }
      },
      "end": "\\}",
      "endCaptures": {
        "0": {
          "name": "punctuation.section.block.end.wire"
        }
      },
      "patterns": [
        {
          "include": "#typed-fields"
        }
      ]
    },
    "input-declaration": {
      "begin": "\\b(input)\\s*(\\{)",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.declaration.input.wire"
        },
        "2": {
          "name": "punctuation.section.block.begin.wire"
        }
      },
      "end": "\\}",
      "endCaptures": {
        "0": {
          "name": "punctuation.section.block.end.wire"
        }
      },
      "patterns": [
        {
          "include": "#typed-fields"
        }
      ]
    },
    "schema-declaration": {
      "begin": "\\b(schema)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*(\\{)",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.declaration.schema.wire"
        },
        "2": {
          "name": "entity.name.type.schema.wire"
        },
        "3": {
          "name": "punctuation.section.block.begin.wire"
        }
      },
      "end": "\\}",
      "endCaptures": {
        "0": {
          "name": "punctuation.section.block.end.wire"
        }
      },
      "patterns": [
        {
          "include": "#variant-type"
        },
        {
          "include": "#typed-fields"
        }
      ]
    },
    "tool-declaration": {
      "begin": "\\b(tool)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*(\\{)",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.declaration.tool.wire"
        },
        "2": {
          "name": "entity.name.function.tool.wire"
        },
        "3": {
          "name": "punctuation.section.block.begin.wire"
        }
      },
      "end": "\\}",
      "endCaptures": {
        "0": {
          "name": "punctuation.section.block.end.wire"
        }
      },
      "patterns": [
        {
          "include": "#tool-bindings-block"
        },
        {
          "include": "#typed-fields"
        },
        {
          "include": "#object-fields"
        }
      ]
    },
    "mcp-import-declaration": {
      "patterns": [
        {
          "begin": "\\b(tool|resource|prompt)\\b(?:\\s+([A-Za-z_][A-Za-z0-9_]*))?\\s+\\b(from)\\b\\s+(mcp)(\\.)([A-Za-z_][A-Za-z0-9_]*)(\\.)(tool|resource|prompt)(\\.)([A-Za-z0-9_]+(?:-[A-Za-z0-9_]+)*)\\s*(\\{)",
          "beginCaptures": {
            "1": {
              "name": "keyword.control.declaration.import-kind.wire"
            },
            "2": {
              "name": "entity.name.function.import-alias.wire"
            },
            "3": {
              "name": "keyword.control.import.from.wire"
            },
            "4": {
              "name": "keyword.other.reference-root.wire"
            },
            "5": {
              "name": "punctuation.accessor.wire"
            },
            "6": {
              "name": "entity.name.namespace.mcp.wire"
            },
            "7": {
              "name": "punctuation.accessor.wire"
            },
            "8": {
              "name": "keyword.other.mcp-kind.wire"
            },
            "9": {
              "name": "punctuation.accessor.wire"
            },
            "10": {
              "name": "variable.other.reference.mcp-name.wire"
            },
            "11": {
              "name": "punctuation.section.block.begin.wire"
            }
          },
          "end": "\\}",
          "endCaptures": {
            "0": {
              "name": "punctuation.section.block.end.wire"
            }
          },
          "patterns": [
            {
              "include": "#tool-bindings-block"
            },
            {
              "include": "#object-fields"
            }
          ]
        },
        {
          "match": "\\b(tool|resource|prompt)\\b(?:\\s+([A-Za-z_][A-Za-z0-9_]*))?\\s+\\b(from)\\b\\s+(mcp)(\\.)([A-Za-z_][A-Za-z0-9_]*)(\\.)(tool|resource|prompt)(\\.)([A-Za-z0-9_]+(?:-[A-Za-z0-9_]+)*)",
          "captures": {
            "1": {
              "name": "keyword.control.declaration.import-kind.wire"
            },
            "2": {
              "name": "entity.name.function.import-alias.wire"
            },
            "3": {
              "name": "keyword.control.import.from.wire"
            },
            "4": {
              "name": "keyword.other.reference-root.wire"
            },
            "5": {
              "name": "punctuation.accessor.wire"
            },
            "6": {
              "name": "entity.name.namespace.mcp.wire"
            },
            "7": {
              "name": "punctuation.accessor.wire"
            },
            "8": {
              "name": "keyword.other.mcp-kind.wire"
            },
            "9": {
              "name": "punctuation.accessor.wire"
            },
            "10": {
              "name": "variable.other.reference.mcp-name.wire"
            }
          }
        }
      ]
    },
    "mcp-batch-import-declaration": {
      "begin": "\\b(from)\\b\\s+(mcp)(\\.)([A-Za-z_][A-Za-z0-9_]*)(?:\\.(tool|resource|prompt))?\\s*(\\{)",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.import.from.wire"
        },
        "2": {
          "name": "keyword.other.reference-root.wire"
        },
        "3": {
          "name": "punctuation.accessor.wire"
        },
        "4": {
          "name": "entity.name.namespace.mcp.wire"
        },
        "5": {
          "name": "keyword.other.mcp-kind.wire"
        },
        "6": {
          "name": "punctuation.section.block.begin.wire"
        }
      },
      "end": "\\}",
      "endCaptures": {
        "0": {
          "name": "punctuation.section.block.end.wire"
        }
      },
      "patterns": [
        {
          "include": "#mcp-batch-import-item"
        },
        {
          "include": "#tool-bindings-block"
        },
        {
          "include": "#object-fields"
        }
      ]
    },
    "mcp-batch-import-item": {
      "patterns": [
        {
          "begin": "\\b(tool|resource|prompt)\\b\\s+([A-Za-z0-9_]+(?:-[A-Za-z0-9_]+)*)(?:\\s+(as)\\s+([A-Za-z_][A-Za-z0-9_]*))?\\s*(\\{)",
          "beginCaptures": {
            "1": {
              "name": "keyword.control.declaration.import-kind.wire"
            },
            "2": {
              "name": "variable.other.reference.mcp-name.wire"
            },
            "3": {
              "name": "keyword.control.import.as.wire"
            },
            "4": {
              "name": "entity.name.function.import-alias.wire"
            },
            "5": {
              "name": "punctuation.section.block.begin.wire"
            }
          },
          "end": "\\}",
          "endCaptures": {
            "0": {
              "name": "punctuation.section.block.end.wire"
            }
          },
          "patterns": [
            {
              "include": "#tool-bindings-block"
            },
            {
              "include": "#object-fields"
            }
          ]
        },
        {
          "match": "\\b(tool|resource|prompt)\\b\\s+([A-Za-z0-9_]+(?:-[A-Za-z0-9_]+)*)(?:\\s+(as)\\s+([A-Za-z_][A-Za-z0-9_]*))?",
          "captures": {
            "1": {
              "name": "keyword.control.declaration.import-kind.wire"
            },
            "2": {
              "name": "variable.other.reference.mcp-name.wire"
            },
            "3": {
              "name": "keyword.control.import.as.wire"
            },
            "4": {
              "name": "entity.name.function.import-alias.wire"
            }
          }
        }
      ]
    },
    "tool-bindings-block": {
      "begin": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(\\{)",
      "beginCaptures": {
        "1": {
          "name": "entity.other.attribute-name.wire"
        },
        "2": {
          "name": "punctuation.section.block.begin.wire"
        }
      },
      "end": "\\}",
      "endCaptures": {
        "0": {
          "name": "punctuation.section.block.end.wire"
        }
      },
      "patterns": [
        {
          "include": "#object-fields"
        },
        {
          "include": "#typed-fields"
        }
      ]
    },
    "dynamic-declaration": {
      "begin": "\\b(dynamic)\\s*(\\{)",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.declaration.dynamic.wire"
        },
        "2": {
          "name": "punctuation.section.block.begin.wire"
        }
      },
      "end": "\\}",
      "endCaptures": {
        "0": {
          "name": "punctuation.section.block.end.wire"
        }
      },
      "patterns": [
        {
          "include": "#object-fields"
        }
      ]
    },
    "agent-declaration": {
      "begin": "\\b(agent)\\s+([A-Za-z_][A-Za-z0-9_]*)(?:\\s+(for)\\s+((?:[A-Za-z_][A-Za-z0-9_]*|\\{\\s*[A-Za-z_][A-Za-z0-9_]*(?:\\s*,\\s*[A-Za-z_][A-Za-z0-9_]*)*\\s*,?\\s*\\}))\\s+(in)\\s+([^\\{]+?))?\\s*(\\{)",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.declaration.agent.wire"
        },
        "2": {
          "name": "entity.name.function.agent.wire"
        },
        "3": {
          "name": "keyword.control.loop.for.wire"
        },
        "4": {
          "name": "variable.parameter.loop.wire"
        },
        "5": {
          "name": "keyword.control.loop.in.wire"
        },
        "6": {
          "name": "meta.expression.loop-source.wire"
        },
        "7": {
          "name": "punctuation.section.block.begin.wire"
        }
      },
      "end": "\\}",
      "endCaptures": {
        "0": {
          "name": "punctuation.section.block.end.wire"
        }
      },
      "patterns": [
        {
          "include": "#agent-output-block"
        },
        {
          "include": "#agent-properties"
        }
      ]
    },
    "agent-output-block": {
      "begin": "\\b(output)\\s*(\\{)",
      "beginCaptures": {
        "1": {
          "name": "entity.other.attribute-name.wire"
        },
        "2": {
          "name": "punctuation.section.block.begin.wire"
        }
      },
      "end": "\\}",
      "endCaptures": {
        "0": {
          "name": "punctuation.section.block.end.wire"
        }
      },
      "patterns": [
        {
          "include": "#typed-fields"
        }
      ]
    },
    "agent-properties": {
      "patterns": [
        {
          "include": "#model-usage-block"
        },
        {
          "match": "\\b(model|instruction|context|uses)\\b(?=\\s*:)",
          "name": "entity.other.attribute-name.agent-property.wire"
        },
        {
          "match": "\\b(file)\\b(?=\\s+)",
          "name": "keyword.control.directive.file.wire"
        },
        {
          "include": "#object-fields"
        },
        {
          "include": "#type-expression"
        }
      ]
    },
    "model-usage-block": {
      "begin": "\\b(model)\\s*(:)\\s*(model)(\\.)([A-Za-z_][A-Za-z0-9_]*)(?:(\\.)([A-Za-z_][A-Za-z0-9_]*))*\\s*(\\{)",
      "beginCaptures": {
        "1": {
          "name": "entity.other.attribute-name.wire"
        },
        "2": {
          "name": "punctuation.separator.key-value.wire"
        },
        "3": {
          "name": "support.type.reference-root.model.wire"
        },
        "4": {
          "name": "punctuation.accessor.wire"
        },
        "5": {
          "name": "variable.other.reference.model.wire"
        },
        "6": {
          "name": "punctuation.accessor.wire"
        },
        "7": {
          "name": "variable.other.reference.model.member.wire"
        },
        "8": {
          "name": "punctuation.section.block.begin.wire"
        }
      },
      "end": "\\}",
      "endCaptures": {
        "0": {
          "name": "punctuation.section.block.end.wire"
        }
      },
      "patterns": [
        {
          "include": "#inference-block"
        },
        {
          "include": "#object-fields"
        }
      ]
    },
    "inference-block": {
      "begin": "\\b(inference)\\s*(\\{)",
      "beginCaptures": {
        "1": {
          "name": "entity.other.attribute-name.wire"
        },
        "2": {
          "name": "punctuation.section.block.begin.wire"
        }
      },
      "end": "\\}",
      "endCaptures": {
        "0": {
          "name": "punctuation.section.block.end.wire"
        }
      },
      "patterns": [
        {
          "include": "#object-fields"
        }
      ]
    },
    "output-declaration": {
      "begin": "\\b(output)\\s*(\\{)",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.declaration.output.wire"
        },
        "2": {
          "name": "punctuation.section.block.begin.wire"
        }
      },
      "end": "\\}",
      "endCaptures": {
        "0": {
          "name": "punctuation.section.block.end.wire"
        }
      },
      "patterns": [
        {
          "include": "#object-fields"
        }
      ]
    },
    "typed-fields": {
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(:)",
          "captures": {
            "1": {
              "name": "entity.other.attribute-name.wire"
            },
            "2": {
              "name": "punctuation.separator.key-value.wire"
            }
          }
        },
        {
          "include": "#type-expression"
        },
        {
          "include": "#punctuation"
        }
      ]
    },
    "object-fields": {
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "match": "(\"(?:\\\\.|[^\"\\\\\\n])*\")\\s*(:)",
          "captures": {
            "1": {
              "name": "string.quoted.double.field-name.wire"
            },
            "2": {
              "name": "punctuation.separator.key-value.wire"
            }
          }
        },
        {
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(:)",
          "captures": {
            "1": {
              "name": "entity.other.attribute-name.wire"
            },
            "2": {
              "name": "punctuation.separator.key-value.wire"
            }
          }
        },
        {
          "include": "#expressions"
        },
        {
          "include": "#punctuation"
        }
      ]
    },
    "named-object-property": {
      "begin": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(\\{)",
      "beginCaptures": {
        "1": {
          "name": "entity.other.attribute-name.wire"
        },
        "2": {
          "name": "punctuation.section.block.begin.wire"
        }
      },
      "end": "\\}",
      "endCaptures": {
        "0": {
          "name": "punctuation.section.block.end.wire"
        }
      },
      "patterns": [
        {
          "include": "#object-fields"
        }
      ]
    },
    "type-expression": {
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#schema-reference"
        },
        {
          "include": "#variant-type"
        },
        {
          "include": "#enum-type"
        },
        {
          "include": "#type-object"
        },
        {
          "include": "#type-keywords"
        },
        {
          "include": "#strings"
        },
        {
          "include": "#references"
        },
        {
          "include": "#numbers"
        },
        {
          "include": "#punctuation"
        }
      ]
    },
    "schema-reference": {
      "match": "\\b(schema)(\\.)([A-Za-z_][A-Za-z0-9_]*)\\b",
      "captures": {
        "1": {
          "name": "keyword.other.reference-root.wire"
        },
        "2": {
          "name": "punctuation.accessor.wire"
        },
        "3": {
          "name": "entity.name.type.schema.wire"
        }
      }
    },
    "enum-type": {
      "begin": "\\b(enum)\\s*(\\{)",
      "beginCaptures": {
        "1": {
          "name": "storage.type.wire"
        },
        "2": {
          "name": "punctuation.section.block.begin.wire"
        }
      },
      "end": "\\}",
      "endCaptures": {
        "0": {
          "name": "punctuation.section.block.end.wire"
        }
      },
      "patterns": [
        {
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b",
          "name": "constant.language.enum-case.wire"
        },
        {
          "include": "#punctuation"
        }
      ]
    },
    "variant-type": {
      "begin": "\\b(variant)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*(\\{)",
      "beginCaptures": {
        "1": {
          "name": "storage.type.wire"
        },
        "2": {
          "name": "entity.name.type.variant-discriminator.wire"
        },
        "3": {
          "name": "punctuation.section.block.begin.wire"
        }
      },
      "end": "\\}",
      "endCaptures": {
        "0": {
          "name": "punctuation.section.block.end.wire"
        }
      },
      "patterns": [
        {
          "include": "#variant-case"
        }
      ]
