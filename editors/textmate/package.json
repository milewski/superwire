{
  "name": "superwire",
  "displayName": "Superwire",
  "description": "Syntax highlighting for Superwire DSL (.wire files)",
  "version": "1.0.0",
  "scripts": {
    "check": "node scripts/validate-grammar.mjs"
  },
  "engines": {
    "vscode": "^1.0.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "superwire",
        "aliases": ["superwire", "wire"],
        "extensions": [".wire"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "superwire",
        "scopeName": "source.wire",
        "path": "./syntaxes/wire.tmLanguage.json"
      }
    ]
  }
}
