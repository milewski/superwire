<idea-plugin>
    <id>com.superwire.intellij</id>
    <name>Superwire</name>
    <vendor email="support@superwire.dev" url="https://github.com/milewski/superwire">Superwire</vendor>

    <description>
        <![CDATA[
        <h1>Superwire language support for IntelliJ IDEs</h1>
        <ul>
            <li>Syntax highlighting powered by the shared TextMate grammar.</li>
            <li>Compiler checking and diagnostics from the Superwire language server.</li>
            <li>Completion for workflow declarations, properties, references, and builtins.</li>
            <li>Hover, go to definition, document/workspace symbol search, and code folding.</li>
            <li>Document formatting and generated-output code lens markers.</li>
        </ul>
        ]]>
    </description>

    <depends>com.intellij.modules.platform</depends>
    <depends>org.jetbrains.plugins.textmate</depends>
    <depends>org.intellij.plugins.markdown</depends>
    <depends>com.redhat.devtools.lsp4ij</depends>

    <extensions defaultExtensionNs="com.intellij">
        <fileType
                name="Superwire"
                implementationClass="com.superwire.intellij.SuperwireFileType"
                fieldName="INSTANCE"
                language="superwire"
                extensions="wire"/>

        <textmate.bundleProvider implementation="com.superwire.intellij.SuperwireTextMateBundleProvider"/>

        <editorHighlighterProvider
                filetype="Superwire"
                implementationClass="com.superwire.intellij.SuperwireSyntaxHighlighterFactory"/>

        <lang.parserDefinition
                language="superwire"
                implementationClass="com.superwire.intellij.SuperwireParserDefinition"/>

        <lang.foldingBuilder
                language="superwire"
                implementationClass="com.redhat.devtools.lsp4ij.features.foldingRange.LSPFoldingRangeBuilder"
                order="first"/>

        <codeBlockProvider
                language="superwire"
                implementationClass="com.redhat.devtools.lsp4ij.features.codeBlockProvider.LSPCodeBlockProvider"
                order="first"/>
    </extensions>

    <extensions defaultExtensionNs="com.redhat.devtools.lsp4ij">
        <server id="superwire"
                name="Superwire"
                factoryClass="com.superwire.intellij.SuperwireLanguageServerFactory">
            <description>
                <![CDATA[
                Superwire language server integration for IntelliJ.
                ]]>
            </description>
        </server>

        <languageMapping language="superwire" serverId="superwire"/>
    </extensions>

    <extensions defaultExtensionNs="org.intellij.markdown">
        <fenceLanguageProvider implementation="com.superwire.intellij.SuperwireCodeFenceLanguageProvider"/>
        <additionalFenceLanguageSuggester implementation="com.superwire.intellij.SuperwireAdditionalFenceLanguageSuggester"/>
    </extensions>
</idea-plugin>
