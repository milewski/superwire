{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "sequoia",
  "name": "Superwire",
  "logo": {
    "dark": "/logo-light.svg",
    "light": "/logo-light.svg",
    "href": "https://superwire.dev"
  },
  "favicon": "/favicon.svg",
  "colors": {
    "primary": "#8A3E00",
    "light": "#FF9A33",
    "dark": "#E06600"
  },
  "styling": {
    "codeblocks": {
      "languages": {
        "custom": [
          "/languages/wire.tmLanguage.json"
        ]
      }
    }
  },
  "navbar": {
    "links": [
      {
        "label": "GitHub",
        "href": "https://github.com/milewski/superwire"
      },
      {
        "label": "Issues",
        "href": "https://github.com/milewski/superwire/issues"
      }
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/milewski/superwire"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Get Started",
            "pages": [
              "index",
              "introduction",
              "installation",
              "quickstart",
              "cli",
              "playground",
              "editor-setup",
              "troubleshooting"
            ]
          },
          {
            "group": "Build Workflows",
            "pages": [
              "core-concepts/overview",
              "core-concepts/workflows",
              "core-concepts/providers",
              "core-concepts/agents",
              "core-concepts/schemas",
              "core-concepts/dependencies",
              "guides/building-workflows",
              "guides/best-practices",
              "guides/authoring-conventions"
            ]
          },
          {
            "group": "DSL Reference",
            "pages": [
              "syntax/overview",
              "syntax/data-types",
              "syntax/type-annotations",
              "syntax/variables",
              "syntax/expressions",
              "syntax/operators",
              "syntax/control-flow",
              "syntax/string-interpolation",
              "syntax/comments"
            ]
          },
          {
            "group": "MCP and Tools",
            "pages": [
              "mcp/overview",
              "mcp/mcp-servers",
              "mcp/tools",
              "mcp/resources",
              "mcp/prompts",
              "mcp/batch-imports",
              "mcp/lockfiles"
            ]
          },
          {
            "group": "Runtime and API",
            "pages": [
              "api-reference/executor-api",
              "api-reference/streaming-events",
              "api-reference/diagnostics",
              "api-reference/lsp",
              "api-reference/rust-api",
              "advanced/parallel-execution",
              "advanced/context-sharing",
              "advanced/caching",
              "advanced/tool-calling",
              "advanced/error-handling"
            ]
          },
          {
            "group": "Integrations",
            "pages": [
              "integrations/providers",
              "integrations/openai",
              "integrations/laravel"
            ]
          }
        ]
      },
      {
        "tab": "Examples",
        "groups": [
          {
            "group": "Progressive Examples",
            "pages": [
              "examples/basic-agent",
              "examples/structured-output",
              "examples/multi-agent",
              "examples/parallel-processing",
              "examples/context-management",
              "examples/file-directive",
              "examples/mcp-tools",
              "examples/nested-output"
            ]
          }
        ]
      },
      {
        "tab": "Why Superwire",
        "groups": [
          {
            "group": "Start Here",
            "pages": [
              "why-superwire/overview",
              "why-superwire/why-it-exists",
              "why-superwire/workflow-contract"
            ]
          },
          {
            "group": "Design Principles",
            "pages": [
              "why-superwire/controlled-tools",
              "why-superwire/structured-outputs"
            ]
          },
          {
            "group": "Evaluate",
            "pages": [
              "why-superwire/use-cases",
              "why-superwire/comparison",
              "why-superwire/adoption-checklist"
            ]
          }
        ]
      }
    ]
  },
  "appearance": {
    "default": "system"
  },
  "icons": {
    "library": "lucide"
  },
  "interaction": {
    "drilldown": false
  },
  "markdown": {
    "schema": false
  }
}
