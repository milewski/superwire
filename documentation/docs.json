{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Superwire",
  "logo": {
    "dark": "/logo.svg",
    "light": "/logo-light.svg"
  },
  "favicon": "/favicon.svg",
  "colors": {
    "primary": "#FF7F00",
    "light": "#FF9A33",
    "dark": "#E06600"
  },
  "styling": {
    "codeblocks": {
      "languages": {
        "custom": [
          "/languages/wire.tmLanguage.json"
        ]
      }
    }
  },
  "navbar": {
    "links": [
      {
        "label": "GitHub",
        "href": "https://github.com/milewski/superwire"
      },
      {
        "label": "Issues",
        "href": "https://github.com/milewski/superwire/issues"
      }
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/milewski/superwire"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Get Started",
            "pages": [
              "introduction",
              "quickstart",
              "installation"
            ]
          },
          {
            "group": "Core Concepts",
            "pages": [
              "core-concepts/overview",
              "core-concepts/workflows",
              "core-concepts/providers",
              "core-concepts/agents",
              "core-concepts/schemas",
              "core-concepts/dependencies"
            ]
          },
          {
            "group": "DSL Reference",
            "pages": [
              "syntax/overview",
              "syntax/data-types",
              "syntax/type-annotations",
              "syntax/variables",
              "syntax/expressions",
              "syntax/operators",
              "syntax/control-flow",
              "syntax/string-interpolation",
              "syntax/comments"
            ]
          },
          {
            "group": "MCP & Tools",
            "pages": [
              "mcp/mcp-servers",
              "mcp/tools",
              "mcp/resources",
              "mcp/prompts",
              "mcp/batch-imports"
            ]
          },
          {
            "group": "Guides",
            "pages": [
              "guides/building-workflows",
              "guides/best-practices",
              "guides/testing",
              "guides/authoring-conventions"
            ]
          },
          {
            "group": "Runtime",
            "pages": [
              "api-reference/executor-api",
              "advanced/parallel-execution",
              "advanced/context-sharing",
              "advanced/error-handling"
            ]
          },
          {
            "group": "Integrations",
            "pages": [
              "integrations/openai",
              "integrations/ollama",
              "integrations/laravel"
            ]
          }
        ]
      },
      {
        "tab": "Examples",
        "groups": [
          {
            "group": "Examples",
            "pages": [
              "examples/basic-agent",
              "examples/structured-output",
              "examples/multi-agent",
              "examples/parallel-processing",
              "examples/context-management",
              "examples/mcp-tools",
              "examples/nested-output"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "groups": [
          {
            "group": "API Reference",
            "pages": [
              "api-reference/executor-api",
              "api-reference/rust-api",
              "api-reference/lsp",
              "api-reference/diagnostics"
            ]
          }
        ]
      }
    ]
  }
}
