{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Engine AI",
  "logo": {
    "dark": "/logo/dark.svg",
    "light": "/logo/light.svg"
  },
  "favicon": "/favicon.svg",
  "colors": {
    "primary": "#0D9373",
    "light": "#07C983",
    "dark": "#0D9373"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:support@example.com"
      },
      {
        "type": "github",
        "href": "https://github.com/yourusername/engine-ai"
      }
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/yourusername/engine-ai",
      "twitter": "https://twitter.com/yourhandle"
    }
  },
  "navigation": {
    "global": {
      "anchors": [
        {
          "anchor": "Documentation",
          "icon": "book-open-cover",
          "href": "https://docs.example.com"
        },
        {
          "anchor": "Community",
          "icon": "slack",
          "href": "https://community.example.com"
        },
        {
          "anchor": "Blog",
          "icon": "newspaper",
          "href": "https://blog.example.com"
        }
      ]
    },
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Get Started",
            "pages": [
              "introduction",
              "quickstart",
              "installation"
            ]
          },
          {
            "group": "Core Concepts",
            "pages": [
              "core-concepts/overview",
              "core-concepts/providers",
              "core-concepts/agents",
              "core-concepts/schemas",
              "core-concepts/workflows",
              "core-concepts/dependencies"
            ]
          },
          {
            "group": "Language Syntax",
            "pages": [
              "syntax/variables",
              "syntax/data-types",
              "syntax/operators",
              "syntax/control-flow",
              "syntax/string-interpolation",
              "syntax/comments"
            ]
          },
          {
            "group": "Advanced Features",
            "pages": [
              "advanced/parallel-execution",
              "advanced/context-sharing",
              "advanced/tool-calling",
              "advanced/error-handling"
            ]
          },
          {
            "group": "Guides",
            "pages": [
              "guides/building-workflows",
              "guides/testing",
              "guides/deployment",
              "guides/best-practices"
            ]
          },
          {
