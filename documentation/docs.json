            "pages": [
              "integrations/ollama",
              "integrations/openai",
              "integrations/anthropic"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "groups": [
          {
            "group": "API Reference",
            "pages": [
              "api-reference/rust-api",
              "api-reference/javascript-api",
              "api-reference/cli"
            ]
          }
        ]
      },
      {
        "tab": "Examples",
        "groups": [
          {
            "group": "Examples",
            "pages": [
              "examples/basic-agent",
              "examples/multi-agent",
              "examples/structured-output",
              "examples/parallel-processing",
              "examples/context-management"
            ]
          }
        ]
      }
    ]
