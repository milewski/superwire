{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Engine AI",
  "logo": {
    "dark": "/logo/dark.svg",
    "light": "/logo/light.svg"
  },
  "favicon": "/favicon.svg",
  "colors": {
    "primary": "#0D9373",
    "light": "#07C983",
    "dark": "#0D9373"
  },
  "styling": {
    "codeblocks": {
      "languages": {
        "custom": [
          "/ai.tmLanguage.json"
        ]
      }
    }
  },
  "navbar": {
    "links": [
      {
        "label": "GitHub",
        "href": "https://github.com/milewski/engine-ai"
      },
      {
        "label": "Issues",
        "href": "https://github.com/milewski/engine-ai/issues"
      }
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/milewski/engine-ai"
    }
  },
