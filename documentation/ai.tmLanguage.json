{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "ai",
  "scopeName": "source.ai",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#provider"
    },
    {
      "include": "#secrets-block"
    },
    {
      "include": "#schema"
    },
    {
      "include": "#input-block"
    },
    {
      "include": "#output-block"
    },
    {
      "include": "#agent"
    },
    {
      "include": "#expressions"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.ai",
          "match": "//.*$"
        }
      ]
    },
    "provider": {
      "begin": "\\b(provider)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*\\{",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.ai"
        },
        "2": {
          "name": "entity.name.type.provider.ai"
        }
      },
      "end": "\\}",
      "patterns": [
        {
          "include": "#property-assignment"
        },
        {
          "include": "#expressions"
        }
      ]
    },
    "secrets-block": {
      "begin": "\\b(secrets)\\s*\\{",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.ai"
        }
      },
      "end": "\\}",
      "patterns": [
        {
          "include": "#property-assignment"
        },
        {
          "include": "#expressions"
        }
      ]
    },
    "schema": {
      "begin": "\\b(schema)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*\\{",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.ai"
        },
        "2": {
          "name": "entity.name.type.schema.ai"
        }
      },
      "end": "\\}",
      "patterns": [
        {
          "include": "#property-assignment"
        },
        {
          "include": "#expressions"
        }
      ]
    },
    "input-block": {
      "begin": "\\b(input)\\s*\\{",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.ai"
        }
      },
      "end": "\\}",
      "patterns": [
        {
          "include": "#property-assignment"
        },
        {
          "include": "#expressions"
        }
      ]
    },
    "output-block": {
      "begin": "\\b(output)\\s*\\{",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.ai"
        }
      },
      "end": "\\}",
      "patterns": [
        {
          "include": "#property-assignment"
        },
        {
          "include": "#expressions"
        }
      ]
    },
    "agent": {
      "begin": "\\b(agent)\\s+([A-Za-z_][A-Za-z0-9_]*)(?:\\s+(for)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s+(in)\\s+([^\\{]+?))?\\s*\\{",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.ai"
        },
        "2": {
          "name": "entity.name.function.agent.ai"
        },
        "3": {
          "name": "keyword.control.ai"
        },
        "4": {
          "name": "variable.other.ai"
        },
        "5": {
          "name": "keyword.control.ai"
        },
        "6": {
          "name": "variable.other.reference.ai"
        }
      },
      "end": "\\}",
      "patterns": [
        {
          "include": "#property-assignment"
        },
        {
          "include": "#expressions"
        }
      ]
    },
    "property-assignment": {
      "patterns": [
        {
          "match": "\\b(driver|endpoint|api_key|models|model|tools|context|output|prompt|inference)\\b(?=\\s*:)",
          "name": "variable.parameter.ai"
        },
        {
          "match": "\\b(provider|schema|agent|input|output|secrets|for|in)\\b",
          "name": "keyword.control.ai"
        },
        {
          "match": "(\\b[A-Za-z_][A-Za-z0-9_]*\\b)\\s*(:)",
          "captures": {
            "1": {
              "name": "variable.other.property.ai"
            },
            "2": {
              "name": "punctuation.separator.ai"
            }
          }
        }
      ]
    },
    "expressions": {
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#multiline-strings"
        },
        {
          "include": "#strings"
        },
        {
          "include": "#tool-calls"
        },
        {
          "include": "#namespaced-function-calls"
        },
        {
          "include": "#function-calls"
        },
        {
          "include": "#tool-references"
        },
        {
          "include": "#references"
        },
        {
          "include": "#arrays"
        },
        {
          "include": "#object-literal"
        },
        {
          "include": "#types"
        },
        {
          "include": "#numbers"
        },
        {
          "include": "#booleans"
        },
        {
          "include": "#operators"
        },
        {
          "name": "punctuation.separator.ai",
          "match": ","
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.ai",
          "match": "\\b(string|number|float|boolean|null)\\b"
        },
        {
          "match": "\\b(agent|input|schema|tool|secrets)\\b",
          "name": "keyword.other.ai"
        },
        {
          "name": "entity.name.type.schema-reference.ai",
          "match": "\\bschema\\.[A-Za-z_][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.ai",
          "match": "\\b\\d(?:[\\d_]*\\d)?(?:\\.\\d(?:[\\d_]*\\d)?)?\\b"
        }
      ]
    },
    "booleans": {
      "patterns": [
        {
          "name": "constant.language.boolean.ai",
          "match": "\\b(true|false)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.ai",
          "match": "\\|"
        },
        {
          "name": "keyword.operator.ai",
          "match": "\\?\\."
        },
        {
          "name": "punctuation.separator.ai",
          "match": ";"
        }
      ]
    },
    "object-literal": {
      "begin": "\\{",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.block.begin.ai"
        }
      },
      "end": "\\}",
      "endCaptures": {
        "0": {
          "name": "punctuation.section.block.end.ai"
        }
      },
      "patterns": [
        {
          "include": "#property-assignment"
        },
        {
          "include": "#expressions"
        }
      ]
    },
    "tool-calls": {
      "begin": "\\b(tool)(\\.)([A-Za-z_][A-Za-z0-9_]*)\\s*(\\()",
      "beginCaptures": {
        "1": {
          "name": "keyword.other.ai"
        },
        "2": {
          "name": "punctuation.accessor.ai"
        },
        "3": {
          "name": "entity.name.function.ai"
        },
        "4": {
          "name": "punctuation.section.arguments.begin.ai"
        }
      },
      "end": "\\)",
      "endCaptures": {
        "0": {
          "name": "punctuation.section.arguments.end.ai"
        }
      },
      "patterns": [
        {
          "match": "(\\b[A-Za-z_][A-Za-z0-9_]*\\b)\\s*(:)",
          "captures": {
            "1": {
              "name": "variable.parameter.ai"
            },
            "2": {
              "name": "punctuation.separator.ai"
            }
          }
        },
        {
          "include": "#expressions"
        }
      ]
    },
    "namespaced-function-calls": {
      "begin": "\\b(?!tool\\b)([A-Za-z_][A-Za-z0-9_]*)(\\.)([A-Za-z_][A-Za-z0-9_]*)(\\()",
      "beginCaptures": {
        "1": {
          "name": "entity.name.namespace.ai"
        },
        "2": {
          "name": "punctuation.accessor.ai"
        },
        "3": {
          "name": "entity.name.function.ai"
        },
        "4": {
          "name": "punctuation.section.arguments.begin.ai"
        }
      },
      "end": "\\)",
      "endCaptures": {
        "0": {
          "name": "punctuation.section.arguments.end.ai"
        }
      },
      "patterns": [
        {
          "match": "(\\b[A-Za-z_][A-Za-z0-9_]*\\b)\\s*(:)",
          "captures": {
            "1": {
              "name": "variable.parameter.ai"
            },
            "2": {
              "name": "punctuation.separator.ai"
            }
          }
        },
        {
          "include": "#expressions"
        }
      ]
    },
    "function-calls": {
      "begin": "\\b([A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)?)\\s*(\\()",
      "beginCaptures": {
        "1": {
          "name": "entity.name.function.ai"
        },
        "2": {
          "name": "punctuation.section.arguments.begin.ai"
        }
      },
      "end": "\\)",
      "endCaptures": {
        "0": {
          "name": "punctuation.section.arguments.end.ai"
        }
      },
      "patterns": [
        {
          "match": "(\\b[A-Za-z_][A-Za-z0-9_]*\\b)\\s*(:)",
          "captures": {
            "1": {
              "name": "variable.parameter.ai"
            },
            "2": {
              "name": "punctuation.separator.ai"
            }
          }
        },
        {
          "include": "#expressions"
        }
      ]
    },
    "tool-references": {
      "patterns": [
        {
          "match": "\\b(tool)(\\.)([A-Za-z_][A-Za-z0-9_]*)\\b",
          "captures": {
            "1": {
              "name": "keyword.other.ai"
            },
            "2": {
              "name": "punctuation.accessor.ai"
            },
            "3": {
              "name": "entity.name.function.ai"
            }
          }
        }
      ]
    },
    "references": {
      "patterns": [
        {
          "match": "\\b(agent|input|schema|tool|secrets)(\\.)([A-Za-z_][A-Za-z0-9_]*)(?:(\\?\\.|\\.)([A-Za-z_][A-Za-z0-9_]*))*",
          "captures": {
            "1": {
              "name": "keyword.other.ai"
            },
            "2": {
              "name": "punctuation.accessor.ai"
            },
            "3": {
              "name": "variable.other.ai"
            },
            "4": {
              "name": "punctuation.accessor.ai"
            },
            "5": {
              "name": "variable.other.property.ai"
            }
          }
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.ai",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "include": "#string-interpolation"
            },
            {
              "name": "constant.character.escape.ai",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "multiline-strings": {
      "patterns": [
        {
          "name": "string.quoted.triple.ai",
          "begin": "\"\"\"",
          "end": "\"\"\"",
          "patterns": [
            {
              "include": "#string-interpolation"
            }
          ]
        }
      ]
    },
    "string-interpolation": {
      "patterns": [
        {
          "name": "meta.embedded.line.ai",
          "begin": "\\{\\{",
          "end": "\\}\\}",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.template-expression.begin.ai"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.template-expression.end.ai"
            }
          },
          "patterns": [
            {
              "include": "#expressions"
            }
          ]
        }
      ]
    },
    "arrays": {
      "begin": "\\[",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.array.begin.ai"
        }
      },
      "end": "\\]",
      "endCaptures": {
        "0": {
          "name": "punctuation.section.array.end.ai"
        }
      },
      "patterns": [
        {
          "include": "#expressions"
        }
      ]
    }
  },
  "aliases": [
    "ai"
  ],
  "fileTypes": [
    "ai"
  ]
}
