package superwire:tool@0.1.0;

/// @tool-name random_city
/// @tool-description Returns a random city name.

interface schema {
  /// Agent-provided input payload.
  record agent-input {
    /// Optional placeholder field.
    placeholder: option<string>,
  }

  /// Workflow-bound input payload.
  record bound-input {
    /// Optional placeholder field.
    placeholder: option<string>,
  }

  /// Tool output payload.
  record output {
    /// Selected city name.
    city: string,
  }

  schema-types: func(agent: agent-input, bound: bound-input) -> output;
}

world tool-schema {
  import schema;
}
