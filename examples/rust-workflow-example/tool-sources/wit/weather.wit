package superwire:tool@0.1.0;

/// @tool-name weather
/// @tool-description Returns a weather summary for a city.

interface schema {
  /// Agent-provided input payload.
  record agent-input {
    /// City name requested by the agent.
    city: option<string>,
  }

  /// Workflow-bound input payload.
  record bound-input {
    /// City name injected by workflow bindings.
    city: option<string>,
  }

  /// Tool output payload.
  record output {
    /// City resolved by the tool.
    city: string,

    /// Human-readable weather summary.
    summary: string,
  }

  schema-types: func(agent: agent-input, bound: bound-input) -> output;
}

world tool-schema {
  import schema;
}
