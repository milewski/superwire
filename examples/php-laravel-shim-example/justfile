build-tools:
    cargo run --manifest-path "{{justfile_directory()}}/../../Cargo.toml" -p superwire-cli -- tools build "{{justfile_directory()}}"

run-demo city="Madrid" token="dev-superwire-token": build-tools
    #!/usr/bin/env bash
    set -euo pipefail
    script_directory="{{justfile_directory()}}"
    mkdir -p "$script_directory/target"

    SUPERWIRE_INTERNAL_TOKEN="{{token}}" php -S 127.0.0.1:8099 -t "$script_directory/laravel-like/public" > "$script_directory/target/php-laravel.log" 2>&1 &
    php_server_process_id=$!

    trap 'kill "$php_server_process_id"' EXIT

    sleep 1

    CITY="{{city}}" SUPERWIRE_INTERNAL_TOKEN="{{token}}" cargo run --manifest-path "$script_directory/Cargo.toml"
