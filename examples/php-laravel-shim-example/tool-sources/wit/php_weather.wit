package superwire:tool@0.1.0;

/// @tool-name php_weather
/// @tool-description Proxy tool forwarding execution to Laravel WeatherTool.

interface schema {
  /// Agent-provided weather request payload.
  record agent-input {
    /// Optional city coming from model arguments.
    city: option<string>,
  }

  /// Workflow-bound weather request payload.
  record bound-input {
    /// Optional city coming from workflow binding.
    city: option<string>,

    /// Shared internal token validated by middleware.
    internal-token: option<string>,
  }

  /// Weather response payload.
  record output {
    /// City resolved by the tool.
    city: string,

    /// Weather summary text.
    summary: string,

    /// Source attribution.
    source: string,
  }

  schema-types: func(agent: agent-input, bound: bound-input) -> output;
}

world tool-schema {
  import schema;
}
