provider ollama1 {
    driver <- "ollama"
    api_endpoint <- "http://100.76.5.36:11434"
    models <- ["qwen3:8b"]
}

<- agent weather {
    model <- "ollama1/qwen3:8b"
    
    output <- {
        condition: "sunny" | "rainy" | "cloudy" | "snowy"
        temperature: number
    }
    
    prompt <- "Generate a random weather report with condition (sunny/rainy/cloudy/snowy) and temperature in celsius."
}
