provider ollama1 {
    driver <- "ollama"
    api_endpoint <- "http://100.76.5.36:11434"
    models <- ["qwen3:8b", "qwen3.5:27b"]
}

agent person_generator {
    model <- "ollama1/qwen3.5:27b"
    output <- schema {
        name: string
        age: number
        hobby: string
    }

    prompt <- "You generate fake profiles"
}

agent greeter {
    model <- "ollama1/qwen3.5:27b"
    prompt <- "Write a warm welcome message to {{ agent.person_generator.name }}"
}

agent summary {
    model <- "ollama1/qwen3.5:27b"
    prompt <- "Summarize the following: {{ agent.greeter }}"
}

output {
    context <- compact {
        model <- "ollama1/qwen3.5:27b"
        context <- agent.summary.context
    }
    message <- agent.summary
}
