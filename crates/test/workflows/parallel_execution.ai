provider ollama1 {
    driver <- "ollama"
    api_endpoint <- "http://100.76.5.36:11434"
    models <- ["qwen3:8b"]
}

<- agent joke {
    model <- "ollama1/qwen3:8b"
    prompt <- "Tell me a short programming joke."
}

<- agent fact {
    model <- "ollama1/qwen3:8b"
    prompt <- "Tell me an interesting fact about computers."
}

<- agent quote {
    model <- "ollama1/qwen3:8b"
    prompt <- "Give me an inspiring quote about technology."
}
