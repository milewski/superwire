provider ollama1 {
    driver <- "ollama"
    api_endpoint <- "http://100.76.5.36:11434"
    models <- ["qwen3:8b"]
}

agent one {
    model <- "ollama1/qwen3:8b"

    output <- {
        message: string
    }

    prompt <- "Say hello"
}

agent two {
    model <- "ollama1/qwen3:8b"

    output <- {
        message: string
    }

    prompt <- "Say goodbye"
}

output {
    single_context_summary <- compact {
        model <- "ollama1/qwen3:8b"
        context <- agent.one.context
    }

    multi_context_summary <- compact {
        model <- "ollama1/qwen3:8b"
        context <- [agent.one.context, agent.two.context]
    }
}
