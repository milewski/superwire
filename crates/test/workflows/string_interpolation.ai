provider ollama1 {
    driver <- "ollama"
    api_endpoint <- "http://100.76.5.36:11434"
    models <- ["qwen3:8b"]
}

agent topic {
    model <- "ollama1/qwen3:8b"
    
    output <- {
        name: string
    }
    
    prompt <- "Suggest a random topic for a story. Reply with just the topic name in JSON format."
}

<- agent story {
    model <- "ollama1/qwen3:8b"
    prompt <- "Write a very short story (under 50 words) about: {{ agent.topic.name }}"
}
