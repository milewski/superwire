wit_bindgen::generate!({
    path: "wit",
    world: "superwire-tool",
});

mod superwire_wasm_tool_sdk;

mod user_tool {
    include!("{{tool_source_path}}");
}

use exports::superwire::tool::tool::{Guest, ToolDefinition, ToolError};

fn host_http_get_delegate(request_url: &str) -> Result<String, String> {
    Ok(superwire::tool::host::http_get(request_url))
}

fn host_http_post_json_delegate(
    request_url: &str,
    request_body_json: &str,
    internal_token: Option<&str>,
) -> Result<String, String> {
    Ok(superwire::tool::host::http_post_json(request_url, request_body_json, internal_token))
}

struct GeneratedTool;

impl Guest for GeneratedTool {
    fn definition() -> Result<ToolDefinition, String> {
        crate::superwire_wasm_tool_sdk::host::register_http_get(host_http_get_delegate);
        crate::superwire_wasm_tool_sdk::host::register_http_post_json(host_http_post_json_delegate);

        let tool_definition = crate::superwire_wasm_tool_sdk::build_tool_definition_json::<user_tool::{{tool_type_name}}>()?;

        Ok(ToolDefinition {
            name: tool_definition.name,
            description: tool_definition.description,
            parameters_schema_json: tool_definition.parameters_schema_json,
            bound_parameters_schema_json: tool_definition.bound_parameters_schema_json,
            output_schema_json: tool_definition.output_schema_json,
        })
    }

    fn execute(agent_input_json: String, bound_input_json: String) -> Result<String, ToolError> {
        crate::superwire_wasm_tool_sdk::host::register_http_get(host_http_get_delegate);
        crate::superwire_wasm_tool_sdk::host::register_http_post_json(host_http_post_json_delegate);

        crate::superwire_wasm_tool_sdk::execute_tool_json_blocking::<user_tool::{{tool_type_name}}>(&agent_input_json, &bound_input_json)
            .map_err(|error| ToolError {
                code: error.code,
                message: error.message,
            })
    }
}

export!(GeneratedTool);
