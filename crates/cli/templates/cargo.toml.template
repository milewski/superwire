[package]
name = "{{tool_name}}-wasm-tool"
version = "0.1.0"
edition = "2021"

[lib]
name = "tool_component"
path = "src/lib.rs"
crate-type = ["cdylib"]

[dependencies]
schemars = "1.2"
serde = { version = "1.0", features = ["derive"] }
serde_json = "1.0"
wit-bindgen = "0.55.0"
superwire-wasm-tool-sdk = { path = "{{tool_sdk_crate_path}}" }
{{extra_dependencies}}

[workspace]
