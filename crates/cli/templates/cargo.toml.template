[package]
name = "{{tool_name}}-wasm-tool"
version = "0.1.0"
edition = "2021"

[lib]
name = "tool_component"
path = "src/lib.rs"
crate-type = ["cdylib"]

[dependencies]
wit-bindgen = "0.55.0"
pollster = "0.4"
schemars = "1.2"
serde = { version = "1.0", features = ["derive"] }
serde_json = "1.0"
{{extra_dependencies}}

[workspace]
