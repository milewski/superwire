mod tools;

use engine_ai_core::try_workflow;

#[tokio::main]
async fn main() {
    colog::init();

    match try_workflow!("workflow.ai").await {
        Ok(result) => {
            println!("{}", serde_json::to_string_pretty(&result).unwrap());
        }
        Err(error) => {
            log::error!("Workflow execution failed: {}", error);
            std::process::exit(1);
        }
    }
}
