use engine_ai_core::impl_tool;
use engine_ai_core::tool_error;
use schemars::JsonSchema;
use serde::{Deserialize, Serialize};
use std::process::Command;

#[derive(Debug, Clone, Serialize, Deserialize, JsonSchema)]
pub struct BashParams {
    /// The bash command to execute
    pub command: String,
}

#[derive(Default)]
pub struct BashTool;

impl_tool!(BashTool, BashParams, {
    name: "bash",
    description: "Execute bash commands and return the output",
    execute: |params| {
        let output = Command::new("bash")
            .arg("-c")
            .arg(&params.command)
            .output()
            .map_err(|error| tool_error!(
                format!("Failed to execute command: {}", error),
                "Ensure bash is available and the command is valid"
            ))?;

        let stdout = String::from_utf8_lossy(&output.stdout).to_string();
        let stderr = String::from_utf8_lossy(&output.stderr).to_string();

        Ok(serde_json::json!({
            "command": params.command,
            "stdout": stdout,
            "stderr": stderr,
            "exit_code": output.status.code().unwrap_or(-1),
            "success": output.status.success()
        }))
    }
});
