provider ollama {
    driver <- "ollama"
    api_endpoint <- "http://localhost:11434"
    models <- ["qwen3:8b"]
}

<- agent file_explorer {
    model <- "ollama/qwen3:8b"
    tools <- [tool.bash]
    output <- [string] "list of files and folders"
    prompt <- """
        You are a helpful file system assistant.
        list the files in the current directory and provide a brief summary of what you find.
    """
}
