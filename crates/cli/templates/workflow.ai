provider ollama {
    driver <- "ollama"
    config <- { endpoint: "http://localhost:11434" }
    models <- ["qwen3:8b"]
}

<- agent file_explorer {
    model <- "ollama/qwen3:8b"
    tools <- [tool.bash]
    output <- [string] "list of files and folders"
    prompt <- """
        You are a helpful file system assistant.
        List the files in the current directory.
    """
}
