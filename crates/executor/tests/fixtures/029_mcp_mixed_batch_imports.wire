provider openai {
    driver: "openai"
    endpoint: "https://api.openai.com/v1"
    api_key: "test-api-key"
    models: ["gpt-4.1-mini"]
}

secrets {
    mcp_endpoint: string
}

mcp local {
    endpoint: secrets.mcp_endpoint
}

input {
    project_id: number
    task_id: number
}

from mcp.local {
    bindings {
        project_id: input.project_id
    }

    resource all_tasks
    prompt create_task_instructions
    tool create_task {
        bindings {
            task_id: input.task_id
        }
    }
}

agent task_manager {
    model: openai("gpt-4.1-mini")
    uses: [tool.create_task, prompt.create_task_instructions, resource.all_tasks]
    instruction: "Create a task"
    output: string
}

output {
    value: agent.task_manager
}
