provider openai {
    driver: "openai"
    endpoint: "http://localhost:1234/v1"
    api_key: "test-api-key"
    models: ["model-a"]
}

secrets {
    mcp_endpoint: string
}

mcp local {
    endpoint: secrets.mcp_endpoint
}

tool fetch_numbers from mcp.local.tool.fetch_numbers

agent analyzer {
    model: openai("model-a")

    dynamic {
        example: call tool.fetch_numbers {
            input {
                override: 123
                base: "keep"
                append: "xyz"
            }
        }
    }

    instruction: "Process fetched values"
    output: string
}

output {
    result: agent.analyzer
}
