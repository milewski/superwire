provider openai {
    driver: "openai"
    endpoint: "http://localhost:1234/v1"
    api_key: "test-api-key"
    models: ["model-a"]
}

agent writer {
    model: openai("model-a")

    instruction: """
        You are a friendly assistant.
        Write a short welcome message.
        Keep it to one sentence.
    """

    output: string
}

output {
    message: agent.writer
}
