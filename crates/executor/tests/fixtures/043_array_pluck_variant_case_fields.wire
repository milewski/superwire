secrets {
    mcp_endpoint: string
}

mcp local {
    endpoint: secrets.mcp_endpoint
}

from mcp.local {
    bindings {
        project_id: 14
    }

    tool fetch_qualitative_question_answers {
        bindings {
            task_types: ["video_recording"]
        }

        output {
            answers: [schema.answer]
        }
    }
}

schema answer {
    task_id: string
    participant_id: number
    answer: variant task_type {
        open_written {
            text: string
        }
        video_recording {
            attachments: [
                variant type {
                    video {
                        id: number
                        transcript: string
                        url: string
                    }
                }
            ]
        }
    }
}

dynamic {
    video_recording_answers: call tool.fetch_qualitative_question_answers
}

output {
    result: dynamic.video_recording_answers.answers.*.answer.*.attachments
}
