provider openai from openai {
    endpoint: "http://localhost:1234/v1"
    api_key: "test-api-key"
}

model openai_model from openai {
    id: "model-a"
}

input {
    topic: string
}

agent first {
    model: model.openai_model
    instruction: input.topic
    output: string
}

agent second {
    model: model.openai_model
    instruction: agent.first
    output: string
}

output {
    result: agent.second
}
