provider openai {
    driver: "openai"
    endpoint: "http://localhost:1234/v1"
    api_key: "test-api-key"
    models: ["model-a"]
}

input {
    topic: string
}

agent first {
    model: openai("model-a")
    prompt: input.topic
    output: string
}

agent second {
    model: openai("model-a")
    prompt: agent.first
    output: string
}

output {
    result: agent.second
}
