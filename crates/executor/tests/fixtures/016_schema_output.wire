provider openai {
    driver: "openai"
    endpoint: "http://localhost:1234/v1"
    api_key: "test-api-key"
    models: ["model-a"]
}

schema person {
    /// Full name
    name: string
    /// Age in years
    age: number
    /// Job role
    role: string
}

agent profile {
    model: openai("model-a")
    instruction: "Generate a person profile."
    output: schema.person
}

output {
    profile: agent.profile
    name: agent.profile.name
    age: agent.profile.age
}
