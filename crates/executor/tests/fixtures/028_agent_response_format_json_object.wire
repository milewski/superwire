provider openai {
    driver: "openai"
    endpoint: "http://localhost:1234/v1"
    api_key: "test-api-key"
    models: ["model-a"]
}

agent profile {
    model: openai("model-a")
    response_format: json_object
    prompt: "Generate a profile."
    output: {
        name: string
    }
}

output {
    profile: agent.profile
}
