secrets {
    mcp_endpoint: string
}

mcp local {
    endpoint: secrets.mcp_endpoint
}

input {
    workspace_id: string
}

resource project_readme from mcp.local.resource.project-readme {
    bindings {
        workspace_id: input.workspace_id
    }
}

dynamic {
    readme: read resource.project_readme {
        params {
            section: "setup"
        }
    }
}

output {
    readme: dynamic.readme
}
