provider openai {
    driver: "openai"
    endpoint: "http://localhost:1234/v1"
    api_key: "test-api-key"
    models: ["model-a"]
}

agent profile {
    model: openai("model-a")
    prompt: "Generate a user profile with name, age, and role."
    output: {
        name: string
        age: number
        role: string
    }
}

output {
    profile: agent.profile
}
