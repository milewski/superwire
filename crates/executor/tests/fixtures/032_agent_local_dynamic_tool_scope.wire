provider openai from openai {
endpoint: "http://localhost:1234/v1"
    api_key: "test-api-key"
}

model openai_model from openai {
    id: "model-a"
}

secrets {
    mcp_endpoint: string
}

mcp local {
    endpoint: secrets.mcp_endpoint
}

tool fetch_task_data from mcp.local.tool.fetch_task_data

agent agent_a {
    model: model.openai_model
    instruction: "Prepare dependency value"
    output: string
}

agent agent_b {
    model: model.openai_model

    dynamic {
        fetched: call tool.fetch_task_data {
            input {
                project_id: 7
                depends_on: agent.agent_a
            }
        }
    }

    instruction: "Use dependency from agent_a"
    output: string
}

output {
    first: agent.agent_a
    second: agent.agent_b
}
