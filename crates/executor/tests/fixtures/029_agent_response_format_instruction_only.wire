provider openai {
    driver: "openai"
    endpoint: "http://localhost:1234/v1"
    api_key: "test-api-key"
    models: ["model-a"]
}

agent greeting {
    model: openai("model-a")
    response_format: instruction_only
    prompt: "Write a greeting."
    output: string
}

output {
    greeting: agent.greeting
}
