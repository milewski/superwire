provider primary from openai {
endpoint: "http://localhost:1234/v1"
    api_key: "test-primary-key"
}

model primary_model_a from primary {
    id: "model-a"
}

model primary_model_c from primary {
    id: "model-c"
}

provider backup from openai {
endpoint: "http://localhost:1234/v1"
    api_key: "test-backup-key"
}

model backup_model from backup {
    id: "model-b"
}

input {
    topic: string
}

agent draft {
    model: model.primary_model_a
    instruction: "Draft summary for {{ input.topic }}"
    output: string
}

agent review {
    model: model.backup_model
    instruction: "Review this draft: {{ agent.draft }}"
    output: string
}

agent finalize {
    model: model.primary_model_c
    instruction: "Finalize using review: {{ agent.review }}"
    output: string
}

output {
    draft: agent.draft
    review: agent.review
    final: agent.finalize
}
