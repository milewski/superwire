provider openai {
    driver: "openai"
    endpoint: "http://localhost:1234/v1"
    api_key: "test-api-key"
    models: ["model-a"]
}

agent greeting {
    model: openai("model-a")
    response_format: json_schema
    prompt: "Write a short welcome message."
    output: string
}

output {
    greeting: agent.greeting
}
