secrets {
    api_key: string
}

provider openai {
    driver: "openai"
    endpoint: "http://localhost:1234/v1"
    api_key: secrets.api_key
    models: ["model-a"]
}

agent assistant {
    model: openai("model-a")
    instruction: "Say hello."
    output: string
}

output {
    greeting: agent.assistant
}
