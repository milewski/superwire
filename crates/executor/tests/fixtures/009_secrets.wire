secrets {
    api_key: string
}

provider openai from openai {
    endpoint: "http://localhost:1234/v1"
    api_key: secrets.api_key
}

model openai_model from openai {
    id: "model-a"
}

agent assistant {
    model: model.openai_model
    instruction: "Say hello."
    output {
        value: string
    }
}

output {
    greeting: agent.assistant.value
}
