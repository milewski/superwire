provider openai {
    driver: "openai"
    endpoint: "http://localhost:1234/v1"
    api_key: "test-api-key"
    models: ["model-a"]
}

input {
    topic: string
}

agent writer {
    model: openai("model-a")
    prompt: "Write about {{ input.topic }}."
    output: string
}

output {
    content: agent.writer
}
