secrets {
    mcp_endpoint: string
}

mcp local {
    endpoint: secrets.mcp_endpoint
}

input {
    project_id: number
    task_id: number
}

prompt from mcp.local.prompt.summarize_task_prompt {
    bindings {
        project_id: input.project_id
        type_id: input.task_id
    }
}

dynamic {
    summary: render prompt.summarize_task_prompt
}

output {
    summary: dynamic.summary
}
