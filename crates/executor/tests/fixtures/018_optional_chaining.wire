provider openai {
    driver: "openai"
    endpoint: "http://localhost:1234/v1"
    api_key: "test-api-key"
    models: ["model-a"]
}

agent data {
    model: openai("model-a")
    instruction: "Generate data with a nullable nested object."
    output: {
        label: string
        details: maybe {
            score: number
            tags: [string]
        }
    }
}

output {
    label: agent.data.label
    score: agent.data.details?.score
    tags: agent.data.details?.tags
}
