provider openai from openai {
    endpoint: "http://localhost:1234/v1"
    api_key: "test-api-key"
}

model openai_model from openai {
    id: "model-a"
}

agent analyzer {
    model: model.openai_model
    instruction: "Write a funny joke about a cat."
    output {
        result: string
    }
}

output {
    compacted: compact agent.analyzer {
        instruction: "Compact this context for final output."
    }
}
