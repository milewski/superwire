provider openai from openai {
    endpoint: "http://localhost:1234/v1"
    api_key: "test-api-key"
}

model openai_model from openai {
    id: "model-a"
}

schema actor {
    name: string
}

schema event_wrapper {
    event: variant type {
        created {
            id: string
            actor: schema.actor
        }
        deleted {
            id: string
            reason: maybe string
        }
    }
    nullable_event: maybe variant type {
        created {
            id: string
        }
        deleted {
            id: string
            reason: maybe string
        }
    }
}

agent event_agent {
    model: model.openai_model

    instruction: "Generate an event wrapper."

    output {
        value: schema.event_wrapper
    }
}

output {
    event_id: match agent.event_agent.value.event {
        created.id
        deleted.id
    }
    created_actor: agent.event_agent.value.event#created.actor.name ?? "not-created"
    deleted_reason: agent.event_agent.value.event#deleted.reason ?? "not-deleted"

    nullable_event_id: match agent.event_agent.value.nullable_event {
        created.id
        deleted.id
        _ "none"
    }
    nullable_deleted_reason: agent.event_agent.value.nullable_event#deleted.reason ?? "none"
}
