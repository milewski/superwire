secrets {
    mcp_endpoint: string
}

mcp local {
    endpoint: secrets.mcp_endpoint
}

input {
    project_id: number
    task_id: number
}

from mcp.local.prompt {
    bindings {
        project_id: input.project_id
    }

    prompt create_task_instructions {
        bindings {
            task_id: input.task_id
        }
    }
}

from mcp.local.resource {
    bindings {
        project_id: input.project_id
    }

    resource all_tasks
}

dynamic {
    instructions: render prompt.create_task_instructions {
        bindings {
            audience: "maintainers"
        }
    }
    tasks: read resource.all_tasks {
        bindings {
            section: "open"
        }
    }
}

output {
    instructions: dynamic.instructions
    tasks: dynamic.tasks
}
