// This example demonstrates the `inference` attribute on an agent.
// Use `inference` to control generation settings like temperature and max tokens.

provider openai from openai {
}

model openai_model from openai {
    id: "gpt-4.1-mini"
}

agent release_analyst {
    model: model.openai_model {
        inference {
            temperature: 0.2
            max_tokens: 12_000
        }
    }

    instruction: "Write a short release readiness note."
    output: string
}

output {
    note: agent.release_analyst
}
