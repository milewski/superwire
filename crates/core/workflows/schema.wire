// This file demonstrates two ways to define agent output schemas:
// 1) Named schema (reusable)
// 2) Inline schema (local to one agent)
// Note: these two agents run in parallel because they do not depend on each other.

// Provider defines where models come from.
provider ollama {
    driver: "ollama"
    models: ["qwen3.5:32b"]
}

// Named schema: define once, reuse across agents.
schema person {
    /// Participant full name
    name: string
    /// Participant age in years
    age: number
    /// Participant role in the study
    role: string
    /// Exactly three hobbies for the participant
    hobbies: [string; 3]
}

// Agent A uses the named schema.
// Use this style when the shape is shared or important enough to name.
agent named_profile {
    model: ollama("qwen3.5:32b")
    instruction: "Generate a fictional user research participant profile."

    // Reference a previously defined schema.
    output: schema.person
}

// Agent B uses an inline schema.
// Use this style for one-off shapes that are not reused elsewhere.
agent inline_profile {
    model: ollama("qwen3.5:32b")
    instruction: "Generate a fictional user research participant profile."

    // Inline schema is local to this agent only.
    output: {
        /// Participant full name
        name: string
        /// Participant age in years
        age: number
        /// Participant role in the study
        role: string
        /// Exactly three hobbies for the participant
        hobbies: [string; 3]
    }
}

// Final output builds values from both agents.
// You can expose the full object, or select individual fields with dot access.
output {
    named_profile: agent.named_profile
    inline_profile: agent.inline_profile
    named_name: agent.named_profile.name
    inline_role: agent.inline_profile.role
}
