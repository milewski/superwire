// This example shows object destructuring with input-driven iteration.
// The loop binds `id` and `profile`, where `profile` remains a nested object.

provider ollama {
    driver: "ollama"
    models: ["qwen3:8b"]
}

input {
    participants: [{
        id: number
        profile: {
            team: string
            city: string
        }
    }]
}

agent participant_note for { id, profile } in input.participants {
    model: ollama("qwen3:8b")
    instruction: "Participant #{{ id }} belongs to {{ profile.team }} in {{ profile.city }}."
    output: {
        id: number
        note: string
    }
}

output {
    notes: agent.participant_note
}
