// This example demonstrates object destructuring in agent for-clauses.
// The loop binds `id` and `name` directly from each participant object.

provider ollama from ollama {
}

model ollama_model from ollama {
    id: "qwen3:8b"
}

agent alpha {
    model: model.ollama_model
    instruction: "Generate participants and tasks for a sprint planning note."
    output {
        tasks: [{
            /// the unique identifier of the task
            id: number
        }]
        participants: [{
            /// the unique identifier of the participant
            id: number
            /// human-readable participant name
            name: string
        }]
    }
}

agent analyzer for { id, name } in agent.alpha.participants {
    model: model.ollama_model
    instruction: "Write a short workload summary for participant #{{ id }} ({{ name }})."
    output {
        participant_id: number
        participant_name: string
        summary: string
    }
}

output {
    generated_participants: agent.alpha.participants
    participant_summaries: agent.analyzer
}
