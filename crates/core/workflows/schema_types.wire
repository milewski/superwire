// This file demonstrates schema field types, inline property descriptions,
// nullable fields (`maybe`), and named schema references.

provider ollama from ollama {
}

model ollama_model from ollama {
    id: "qwen3.5:32b"
}

// Schema and field descriptions are preserved into JSON Schema
// descriptions to help the LLM produce better structured output.
schema all_types {
    /// A basic string value
    string_value: string
    /// A numeric value
    number_value: number
    /// A floating-point value
    float_value: float
    /// A true/false value
    boolean_value: boolean
    /// A nullable field that may be null
    nullable_value: maybe string
    /// A nullable string; the field must exist, but may be null
    nullable_string: maybe string
    /// A nullable number; the field must exist, but may be null
    nullable_number: maybe number
    /// An array of strings
    array: [string]
    /// Exactly three strings
    fixed_array: [string; 3]
    /// An array of inline objects

    // Nullable fields

    // Array types

    // An array of objects with inline schema definition.
    array_of_objects: [{
        /// Stable identifier for the item
        id: string
        /// Numeric score for the item
        score: number
    }]
    /// A fixed set of string values
    enum_value: enum { draft, ready, published }
    /// A nullable enum value
    nullable_enum: maybe enum { draft, ready, published }
    /// A tuple with mixed item types
    tuple_value: (string, number, [string; 3])
    /// A nullable tuple
    nullable_tuple: maybe (string, number, [string; 3])
    /// A nested object value

    // Enum types

    // Tuple types

    // Nested object with inline schema definition.
    object_value: {
        /// Nested string field
        string_value: string
        /// Nested number field
        number_value: number
    }
    /// A nullable nested object value

    // A nullable nested object.
    nullable_object: maybe {
        /// Nested string field
        string_value: string
        /// Nested number field
        number_value: number
    }
}

// A schema can be referenced inside another schema.
schema participant {
    /// Participant name
    name: string
    /// Participant role
    role: string
}

schema research_summary {
    /// Research summary title
    title: string
    /// Primary participant for the summary
    lead: schema.participant
    /// All participants included in the summary
    participants: [schema.participant]
}

// Input can also use named schemas.
input {
    lead_participant: schema.participant
    participant_list: [schema.participant]
    previous_summary: schema.research_summary
}

agent typed_example {
    model: model.ollama_model

    instruction: """
        Generate a JSON object that matches the all_types schema exactly.
        - Lead={{ input.lead_participant }},
        - participants={{ input.participant_list }},
        - previous_title={{ input.previous_summary.title }}
    """

    // Agent output blocks define the structured fields directly.
    output {
        /// A basic string value
        string_value: string
        /// A numeric value
        number_value: number
        /// A floating-point value
        float_value: float
        /// A true/false value
        boolean_value: boolean
        /// A nullable field that may be null
        nullable_value: maybe string
        /// A nullable string; the field must exist, but may be null
        nullable_string: maybe string
        /// A nullable number; the field must exist, but may be null
        nullable_number: maybe number
        /// An array of strings
        array: [string]
        /// Exactly three strings
        fixed_array: [string; 3]
        /// An array of inline objects
        array_of_objects: [{
            /// Stable identifier for the item
            id: string
            /// Numeric score for the item
            score: number
        }]
        /// A fixed set of string values
        enum_value: enum { draft, ready, published }
        /// A nullable enum value
        nullable_enum: maybe enum { draft, ready, published }
        /// A tuple with mixed item types
        tuple_value: (string, number, [string; 3])
        /// A nullable tuple
        nullable_tuple: maybe (string, number, [string; 3])
        /// A nested object value
        object_value: {
            /// Nested string field
            string_value: string
            /// Nested number field
            number_value: number
        }
        /// A nullable nested object value
        nullable_object: maybe {
            /// Nested string field
            string_value: string
            /// Nested number field
            number_value: number
        }
        /// A discriminated variant object
        event: variant type {
            created {
                /// Created event identifier
                id: string
                /// Participant that created the event
                actor: schema.participant
            }
            deleted {
                /// Deleted event identifier
                id: string
                /// Optional deletion reason
                reason: maybe string
            }
        }
        /// A nullable discriminated variant object
        nullable_event: maybe variant type {
            created {
                /// Created nullable event identifier
                id: string
            }
            deleted {
                /// Deleted nullable event identifier
                id: string
                /// Optional nullable deletion reason
                reason: maybe string
            }
        }
    }
}

output {
    // Full object output.
    result: agent.typed_example

    // Field selection with dot access.
    string_value: agent.typed_example.string_value
    number_value: agent.typed_example.number_value
    float_value: agent.typed_example.float_value
    boolean_value: agent.typed_example.boolean_value
    nullable_value: agent.typed_example.nullable_value

    // Nullable fields are accessed the same way as non-nullable fields.
    nullable_string: agent.typed_example.nullable_string
    nullable_number: agent.typed_example.nullable_number

    // Array and tuple fields can also be accessed directly.
    array: agent.typed_example.array
    fixed_array: agent.typed_example.fixed_array
    array_of_objects: agent.typed_example.array_of_objects

    // Enum and tuple fields can be accessed directly as well.
    enum_value: agent.typed_example.enum_value
    nullable_enum: agent.typed_example.nullable_enum
    tuple_value: agent.typed_example.tuple_value
    nullable_tuple: agent.typed_example.nullable_tuple

    // Nested object fields can be accessed with dot notation.
    object_value: agent.typed_example.object_value
    nested_string: agent.typed_example.object_value.string_value
    nested_number: agent.typed_example.object_value.number_value

    // For nullable nested objects, the entire object is nullable.
    nullable_object: agent.typed_example.nullable_object

    // Accessing a nullable property requires `?.`.
    nullable_object_string: agent.typed_example.nullable_object?.string_value

    // Variant fields support match projection.
    event_id: match agent.typed_example.event {
        created.id
        deleted.id
    }
    created_actor_name: agent.typed_example.event#created.actor.name ?? "not-created"
    deleted_reason: agent.typed_example.event#deleted.reason ?? "not-deleted"

    // Nullable variants support match with a default branch.
    nullable_event_id: match agent.typed_example.nullable_event {
        created.id
        deleted.id
        _ "none"
    }
    nullable_deleted_reason: agent.typed_example.nullable_event#deleted.reason ?? "none"
}
