// This example demonstrates the new tool call syntax with let bindings and deterministic execution.

secrets {
    api_key: string
}

provider openai {
    driver: "openai"
    endpoint: "http://localhost"
    api_key: "test"
    models: ["gpt-4.1-mini"]
}

input {
    user_query: string
}

dynamic {
    max_results: 5
    timeout_seconds: 30
}

/// defining multiple times it merges the keys
dynamic {
    another_max_results: 5

    /// if there are duplicate keys already defined in other dynamic block it should throw an error
    timeout_seconds: 30
}

tool searchable_web {
    description: "Search the web with configurable limits"
    /// if defining multiple properties in a single line need to add a `,` to separate, throw an error otherwise
    input { query: string, limit: number }
    bindings { api_key: string, timeout: number }
    output { results: [string], total_count: number }
}

tool format_response {
    description: "Format a response into structured output"

    input {
        content: string
    }

    output {
        formatted: string
        word_count: number
    }
}

dynamic {
    example: "hello world"
    model: openai("gpt-4.1-mini")
    tools: [ tool.some_tool ]
    another_example: {
        demo: 123
    }
    search_results: call tool.searchable_web {
        input {
            query: input.user_query
            limit: config.max_results
        }
        bindings {
            api_key: secrets.api_key
            timeout: config.timeout_seconds
        }
    }
}

agent research_agent {
    model: dynamic.model
    tools: dynamic.tools

    dynamic {
        search_results: call tool.searchable_web {
            input: {
                query: input.user_query
                limit: config.max_results
            }
            bindings: {
                api_key: secrets.api_key
                timeout: config.timeout_seconds
            }
        }

        formatted_result: call tool.format_response {
            input {
                content: "test content"
            }
        }
    }

    output {
        answer: string
    }
}

output {
    answer: agent.research_agent
}