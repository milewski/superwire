// This example demonstrates top-level tool declarations and agent tool usage.
// Tool declarations define the model-facing input schema and bindings arguments.

secrets {
    knowledge_base_password: string
    issue_tracker_token: string
}

provider openai {
    driver: "openai"
    endpoint: "http://localhost"
    api_key: "123"
    models: ["gpt-4.1-mini"]
}

input {
    question: string
}

tool web_search {
    description: "Search the public web"

    input {
        query: string
    }
}

tool knowledge_base_search {
    description: "Search the internal knowledge base"

    input {
        query: string
    }

    bindings {
        password: string
    }
}

tool issue_tracker_lookup {
    description: "Retrieve details about an issue"

    input {
        issue_id: number
    }

    bindings {
        project: string
        status: "open" | "closed"
        token: string
    }
}

agent assistant_with_tools {
    model: openai("gpt-4.1-mini")

    // The agent can decide when to call these tools.
    // Bounded tool arguments can use literals, references, and secrets.
    tools: [
        // No arguments.
        tool.web_search,

        // One argument.
        tool.knowledge_base_search(password: secrets.knowledge_base_password),

        // Multiple arguments.
        tool.issue_tracker_lookup(project: "engine-ai", status: "open", token: secrets.issue_tracker_token),
    ]

    prompt: "Answer the question using tools when needed: {{ input.question }}"
    output: {
        answer: string
        sources: [string]
    }
}

output {
    answer: agent.assistant_with_tools.answer
    sources: agent.assistant_with_tools.sources
}
