// This example demonstrates the `secret` directive.
// Secrets are used for sensitive configuration values.
// If a secret is referenced in prompt/context/output, parsing fails to prevent leaks.

secrets {
    openai_api_key: string
}

// Local provider endpoint is regular config (not secret).
provider ollama_local from ollama {
    endpoint: "http://127.0.0.1:11434"
}

model ollama_local_model from ollama_local {
    id: "qwen3:8b"
}

// Cloud provider endpoint is regular config, API key comes from secrets.
provider openai_cloud from openai {
endpoint: "https://api.openai.com/v1"
    api_key: secrets.openai_api_key
}

model openai_cloud_model from openai_cloud {
    id: "gpt-4.1-mini"
}

input {
    interview_notes: [string]
}

// Step 1: summarize notes locally.
agent local_summary {
    model: model.ollama_local_model
    instruction: "Summarize these user interview notes into 3 key findings: {{ input.interview_notes }}"
    output {
        findings: [string; 3]
    }
}

// Step 2: refine findings with cloud model.
agent cloud_brief {
    model: model.openai_cloud_model
    instruction: "Turn these findings into a concise research brief: {{ agent.local_summary.findings }}"
    output {
        brief: string
        recommendations: [string]
    }
}

output {
    findings: agent.local_summary.findings
    brief: agent.cloud_brief.brief
    recommendations: agent.cloud_brief.recommendations
}
