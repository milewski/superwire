workflow = { SOI ~ declaration* ~ EOI }

declaration = _{
    provider_declaration
    | mcp_declaration
    | secrets_declaration
    | input_declaration
    | schema_declaration
    | mcp_tool_batch_import_declaration
    | tool_import_declaration
    | resource_import_declaration
    | prompt_import_declaration
    | tool_block_declaration
    | dynamic_declaration
    | agent_declaration
    | output_declaration
}

provider_declaration = { "provider" ~ identifier ~ object_expression }
mcp_declaration = { "mcp" ~ identifier ~ object_expression }
secrets_declaration = { "secrets" ~ typed_block }
input_declaration = { "input" ~ typed_block }
schema_declaration = { "schema" ~ identifier ~ typed_block }
tool_block_declaration = { "tool" ~ identifier ~ tool_block }
tool_import_declaration = { "tool" ~ ("from" | identifier ~ "from") ~ mcp_import_reference ~ tool_import_block? }
resource_import_declaration = { "resource" ~ ("from" | identifier ~ "from") ~ mcp_import_reference ~ mcp_import_block? }
prompt_import_declaration = { "prompt" ~ ("from" | identifier ~ "from") ~ mcp_import_reference ~ mcp_import_block? }

mcp_tool_batch_import_declaration = { "from" ~ mcp_tool_batch_import_source ~ mcp_tool_batch_import_block }
mcp_tool_batch_import_source = { "mcp" ~ "." ~ identifier ~ "." ~ "tool" }
mcp_tool_batch_import_block = { "{" ~ mcp_tool_batch_import_property* ~ "}" }
mcp_tool_batch_import_property = _{ named_object_property | named_unsigned_integer_property | mcp_tool_batch_import_item }
mcp_tool_batch_import_item = { "tool" ~ mcp_import_name ~ ("as" ~ identifier)? ~ object_expression? }

tool_import_block = { "{" ~ tool_import_property* ~ "}" }
tool_import_property = _{ named_object_property | named_unsigned_integer_property }

mcp_import_reference = { "mcp" ~ "." ~ identifier ~ "." ~ mcp_import_kind ~ "." ~ mcp_import_name }
mcp_import_kind = { "tool" | "resource" | "prompt" }
mcp_import_name = { mcp_tool_name }
mcp_import_block = { "{" ~ mcp_import_property* ~ "}" }
mcp_import_property = _{ named_object_property }

tool_block = { "{" ~ tool_property* ~ "}" }
tool_property = _{ named_plain_string_property | named_unsigned_integer_property | named_tool_block_property | tool_input_field }
named_tool_block_property = { identifier ~ tool_bindings_block }
tool_input_field = { typed_field }
mcp_tool_name = { mcp_tool_name_segment ~ ("-" ~ mcp_tool_name_segment)* }
mcp_tool_name_segment = @{ (ASCII_ALPHA | ASCII_DIGIT | "_")+ }

dynamic_declaration = { "dynamic" ~ object_expression }

agent_declaration = { "agent" ~ identifier ~ for_clause? ~ agent_block }
for_clause = { "for" ~ for_loop_pattern ~ "in" ~ expression }
for_loop_pattern = { identifier | object_destructuring_pattern }
object_destructuring_pattern = { "{" ~ identifier ~ ("," ~ identifier)* ~ ","? ~ "}" }
agent_block = { "{" ~ agent_property* ~ "}" }
agent_property = _{ named_object_property | named_agent_value_property }
named_agent_value_property = { identifier ~ ":" ~ agent_property_value }
agent_property_value = _{ tools_expression | response_format_value | expression ~ plain_string_literal? | type_expression ~ plain_string_literal? }
response_format_value = { "auto" | "json_schema" | "json_object" | "instruction_only" }

tools_expression = { "[" ~ (agent_tool_binding ~ ("," ~ agent_tool_binding)* ~ ","?)? ~ "]" }
agent_tool_binding = { reference ~ agent_tool_binding_block? }
agent_tool_binding_block = { "{" ~ agent_tool_binding_property* ~ "}" }
agent_tool_binding_property = _{ named_object_property | named_unsigned_integer_property }

output_declaration = { "output" ~ object_expression }

typed_block = { "{" ~ typed_field* ~ "}" }
typed_field = { identifier ~ ":" ~ type_expression ~ plain_string_literal? ~ ","? }

tool_bindings_block = { "{" ~ tool_binding_field* ~ "}" }
tool_binding_field = { identifier ~ ":" ~ (tool_binding_type_expression | expression) ~ plain_string_literal? ~ ","? }
tool_binding_type_expression = { tool_binding_type_term ~ ("|" ~ tool_binding_type_term)* }
tool_binding_type_object = { "{" ~ typed_field* ~ "}" }
tool_binding_type_term = _{
    scalar_type
    | schema_reference
    | reference
    | plain_string_literal
    | array_type
    | tuple_type
    | tool_binding_type_object
}

type_expression = { type_term ~ ("|" ~ type_term)* }

type_term = _{
    scalar_type
    | schema_reference
    | reference
    | array_type
    | tuple_type
    | type_object
    | plain_string_literal
}

scalar_type = { "string" | "number" | "float" | "boolean" | "null" }
schema_reference = { "schema" ~ "." ~ identifier ~ !("." ~ identifier) }
array_type = { "[" ~ type_expression ~ (";" ~ unsigned_integer_literal)? ~ "]" }
tuple_type = { "(" ~ type_expression ~ ("," ~ type_expression)* ~ ")" }
type_object = { "{" ~ typed_field* ~ "}" }

expression = _{
    tool_call_expression
    | mcp_call_expression
    | function_call
    | object_expression
    | array_expression
    | boolean_literal
    | null_literal
    | number_literal
    | string_expression
    | reference
}

tool_call_expression = { "call" ~ reference ~ tool_call_block? }
tool_call_block = { "{" ~ tool_call_property* ~ "}" }
tool_call_property = _{ named_object_property | named_unsigned_integer_property }

mcp_call_expression = { mcp_call_keyword ~ reference ~ mcp_call_block? }
mcp_call_keyword = { "read" | "render" }
mcp_call_block = { "{" ~ mcp_call_property* ~ "}" }
mcp_call_property = _{ named_object_property }

named_object_property = { identifier ~ object_expression }
named_plain_string_property = { identifier ~ ":" ~ plain_string_literal }
named_unsigned_integer_property = { identifier ~ ":" ~ unsigned_integer_literal }

object_expression = { "{" ~ object_field* ~ "}" }
object_field = { object_field_name ~ ":" ~ expression }
object_field_name = { identifier | plain_string_literal }

array_expression = { "[" ~ (expression ~ ("," ~ expression)* ~ ","?)? ~ "]" }

function_call = { reference ~ "(" ~ call_arguments? ~ ")" }
call_arguments = { call_argument ~ ("," ~ call_argument)* ~ ","? }
call_argument = { named_argument | expression }
named_argument = { identifier ~ ":" ~ expression }

reference = { identifier ~ (reference_operator ~ identifier)* }
reference_operator = { "?." | "." }

boolean_literal = { "true" | "false" }
null_literal = { "null" }
number_literal = @{ "-"? ~ ASCII_DIGIT ~ (ASCII_DIGIT | "_")* ~ ("." ~ ASCII_DIGIT ~ (ASCII_DIGIT | "_")*)? }
unsigned_integer_literal = @{ ASCII_DIGIT ~ (ASCII_DIGIT | "_")* }

escaped_character = { "\\\\" | "\\\"" | "\\n" | "\\r" | "\\t" | "\\{" | "\\}" }

string_expression = { multiline_string_expression | quoted_string_expression }

quoted_string_expression = ${ "\"" ~ quoted_string_part* ~ "\"" }
quoted_string_part = { interpolation | escaped_character | quoted_string_text }
quoted_string_text = @{ (!("\"" | "\\" | "{" | "}" | NEWLINE) ~ ANY)+ }

multiline_string_expression = ${ "\"\"\"" ~ multiline_string_part* ~ "\"\"\"" }
multiline_string_part = { interpolation | escaped_character | multiline_string_text }
multiline_string_text = @{ (!("\"\"\"" | "\\" | "{" | "}") ~ ANY)+ }

interpolation = !{ "{{" ~ WHITESPACE* ~ expression ~ WHITESPACE* ~ "}}" }

plain_string_literal = _{ plain_multiline_string | plain_quoted_string }
plain_quoted_string = @{ "\"" ~ (escaped_character | !("\"" | NEWLINE) ~ ANY)* ~ "\"" }
plain_multiline_string = @{ "\"\"\"" ~ (!("\"\"\"") ~ ANY)* ~ "\"\"\"" }

identifier = @{ (ASCII_ALPHA | "_") ~ (ASCII_ALPHANUMERIC | "_")* }

WHITESPACE = _{ " " | "\t" | NEWLINE }
COMMENT = _{ "//" ~ (!NEWLINE ~ ANY)* }
