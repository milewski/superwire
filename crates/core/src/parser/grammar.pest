WHITESPACE = _{ " " | "\t" | "\r" | "\n" }
COMMENT = _{ "//" ~ (!"\n" ~ ANY)* }

workflow = { SOI ~ (provider | schema | input_block | output_block | agent)* ~ EOI }

// Provider definition
provider = { "provider" ~ identifier ~ "{" ~ provider_property* ~ "}" }
provider_property = {
    (property_driver ~ "<-" ~ string_value) |
    (property_models ~ "<-" ~ array_value) |
    (property_config ~ "<-" ~ object_value)
}

property_driver = { "driver" }
property_models = { "models" }
property_config = { "config" }

// Schema definition
schema = { "schema" ~ identifier ~ "{" ~ schema_field* ~ "}" }
schema_field = { identifier ~ ":" ~ schema_type ~ string_value? }
schema_type = {
    schema_type_array |
    schema_type_enum |
    schema_type_object |
    schema_type_primitive
}
schema_type_primitive = { "string" | "number" | "boolean" | "null" }
schema_type_array = { "[" ~ schema_type ~ (";" ~ number_value)? ~ "]" }
schema_type_enum = { (schema_type_primitive | string_value) ~ ("|" ~ (schema_type_primitive | string_value))+ }
schema_type_object = { "{" ~ schema_field* ~ "}" }

// Input block
input_block = { "input" ~ "{" ~ input_field* ~ "}" }
input_field = { identifier ~ ":" ~ schema_type }

// Output block
output_block = { "output" ~ "{" ~ output_field* ~ "}" }
output_field = { identifier ~ "<-" ~ value }

// Agent definition
agent = { terminal_marker? ~ "agent" ~ identifier ~ "{" ~ agent_property* ~ "}" }
terminal_marker = { "<-" }

agent_property = {
    (property_model ~ "<-" ~ value) |
    (property_tools ~ "<-" ~ value) |
    (property_context ~ "<-" ~ value) |
    (property_output ~ "<-" ~ schema_reference) |
    (property_prompt ~ "<-" ~ value) |
    (property_for_each ~ "<-" ~ value ~ "as" ~ identifier)
}

property_model = { "model" }
property_tools = { "tools" }
property_context = { "context" }
property_output = { "output" }
property_prompt = { "prompt" }
property_for_each = { "for_each" }

schema_reference = {
    ("schema" ~ "." ~ identifier) |
    inline_schema |
    inline_type
}

inline_schema = { "schema"? ~ "{" ~ schema_field* ~ "}" }

inline_type = { schema_type ~ string_value? }

// Values - NOTE: identifier is NOT a valid value, only references are
value = {
    function_call |
    reference |
    multiline_string |
    string_value |
    interpolated_string |
    number_value |
    boolean_value |
    null_value |
    array_value |
    object_value
}

// Function calls
function_call = { identifier ~ (string_value)? ~ "{" ~ function_binding* ~ "}" }
function_binding = { identifier ~ "<-" ~ value }

// References - these are the ONLY way to reference agents/inputs
reference = {
    agent_context_reference |
    agent_field_reference |
    agent_output_reference |
    input_reference |
    schema_name_reference |
    tool_reference
}

agent_context_reference = { "agent" ~ "." ~ identifier ~ "." ~ "context" }
agent_field_reference = { "agent" ~ "." ~ identifier ~ "." ~ identifier ~ !("." ~ "context") }
agent_output_reference = { "agent" ~ "." ~ identifier ~ !(("." ~ identifier) | ("." ~ "context")) }
input_reference = { "input" ~ "." ~ identifier }
schema_name_reference = { "schema" ~ "." ~ identifier }
tool_reference = { "tool" ~ "." ~ identifier }

// String interpolation
interpolated_string = { string_start ~ interpolated_content+ ~ string_end }
string_start = @{ "\"" }
string_end = @{ "\"" }
interpolated_content = {
    interpolation |
    string_char
}
interpolation = { "{{" ~ reference ~ "}}" }
string_char = @{ (!("\"" | "{{") ~ ANY)+ }

multiline_string = @{ "\"\"\"" ~ multiline_content ~ "\"\"\"" }
multiline_content = { (!("\"\"\"") ~ ANY)* }

// Primitive values
string_value = @{ "\"" ~ string_inner ~ "\"" }
string_inner = { (!(("\"") | ("{{")) ~ ANY)* }

number_value = { "-"? ~ ASCII_DIGIT+ ~ ("." ~ ASCII_DIGIT+)? }
boolean_value = { "true" | "false" }
null_value = { "null" }

array_value = { "[" ~ (value ~ ("," ~ value)* ~ ","?)? ~ "]" }
object_value = { "{" ~ (object_pair ~ ("," ~ object_pair)* ~ ","?)? ~ "}" }
object_pair = { identifier ~ ":" ~ value }

// Identifiers - used for names, not as values
identifier = @{ ASCII_ALPHA ~ (ASCII_ALPHANUMERIC | "_")* }

