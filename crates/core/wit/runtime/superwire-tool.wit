package superwire:tool@0.1.0;

interface types {
  record tool-error {
    code: string,
    message: string,
  }

  record tool-definition {
    name: string,
    description: string,
    parameters-schema-json: string,
    bound-parameters-schema-json: string,
    output-schema-json: string,
  }
}

interface tool {
  use types.{tool-error, tool-definition};

  execute: func(agent-input-json: string, bound-input-json: string) -> result<string, tool-error>;
  definition: func() -> result<tool-definition, string>;
}

interface marker {}

interface host {
  http-get: func(url: string) -> string;
  http-post-json: func(url: string, body-json: string, token: option<string>) -> string;
}

world superwire-tool {
  export tool;
  export marker;
  import host;
}