package superwire:tool@0.1.0;

interface host {
    http-get: func(url: string) -> result<string, string>;
    http-post-json: func(url: string, body-json: string, internal-token: option<string>) -> result<string, string>;
}

interface tool {
    record tool-definition {
        name: string,
        description: string,
        parameters-schema-json: string,
        bound-parameters-schema-json: string,
        output-schema-json: string,
    }

    record tool-error {
        code: string,
        message: string,
    }

    definition: func() -> result<tool-definition, string>;
    execute: func(agent-input-json: string, bound-input-json: string) -> result<string, tool-error>;
}

world superwire-tool {
    import host;
    export tool;
}
