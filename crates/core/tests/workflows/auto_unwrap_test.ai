provider ollama {
    driver <- "ollama"
    config <- { endpoint: "http://100.76.5.36:11434" }
    models <- ["qwen3:8b"]
}

agent single_field {
    model <- "ollama/qwen3:8b"

    output <- {
        value: string
    }

    prompt <- "Say 'hello world'"
}

agent multi_field {
    model <- "ollama/qwen3:8b"

    output <- {
        name: string
        age: number
    }

    prompt <- "Generate a person with name 'Alice' and age 25"
}

output {
    single_unwrapped <- agent.single_field
    single_explicit <- agent.single_field.value
    multi_full <- agent.multi_field
    multi_name <- agent.multi_field.name
    multi_age <- agent.multi_field.age
}
