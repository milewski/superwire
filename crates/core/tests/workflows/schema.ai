provider ollama {
    driver <- "ollama"
    config <- { endpoint: "http://100.76.5.36:11434" }
    models <- ["qwen3:8b"]
}

<- agent person {
    model <- "ollama/qwen3:8b"

    output <- {
        name: string
        age: number
        hobbies: [string]
    }

    prompt <- "Generate a random person with name, age, and hobbies"
}
