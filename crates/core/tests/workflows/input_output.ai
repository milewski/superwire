provider ollama {
    driver <- "ollama"
    config <- { endpoint <- "http://100.76.5.36:11434" }
    models <- ["qwen3:8b"]
}

input {
    topic: string
    audience: string
}

agent research {
    model <- "ollama/qwen3:8b"

    output <- {
        summary: string
        key_points: [string]
    }

    prompt <- "Research the topic: {{ input.topic }} for a {{ input.audience }} audience. Provide a summary and 3 key points."
}

output {
    topic <- input.topic
    audience <- input.audience
    summary <- agent.research.summary
}
