provider ollama {
    driver <- "ollama"
    api_endpoint <- "http://100.76.5.36:11434"
    models <- ["qwen3:8b"]
}

<- agent story {
    model <- "ollama/qwen3:8b"
    
    prompt <- file "./prompts/story_template.md" {
        genre <- "science fiction"
        topic <- "a robot learning emotions"
        length <- "100"
        element <- "a surprising twist"
        tone <- "hopeful"
    }
}
