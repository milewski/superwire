provider ollama {
    driver <- "ollama"
    config <- { endpoint: "http://100.76.5.36:11434" }
    models <- ["qwen3:8b"]
}

// Agent that returns a simple number
agent calculator {
    model <- "ollama/qwen3:8b"
    output <- number "the result of the calculation"
    prompt <- "Calculate 15 * 7 and return only the number"
}

// Agent that returns a simple string
agent greeter {
    model <- "ollama/qwen3:8b"
    output <- string "a friendly greeting message"
    prompt <- "Write a short greeting message (one sentence)"
}

// Agent that returns a boolean
agent validator {
    model <- "ollama/qwen3:8b"
    output <- boolean "whether the number is greater than 100"
    prompt <- "Is {{ agent.calculator }} greater than 100? Return true or false"
}

// Agent that returns an array of strings
agent list_generator {
    model <- "ollama/qwen3:8b"
    output <- [string] "a list of programming languages"
    prompt <- "List 5 popular programming languages as a JSON array of strings"
}

// Agent that uses the results
agent summary {
    model <- "ollama/qwen3:8b"
    prompt <- """
    Summarize the following results:
    - Calculation result: {{ agent.calculator }}
    - Greeting: {{ agent.greeter }}
    - Is greater than 100: {{ agent.validator }}
    - Programming languages: {{ agent.list_generator }}
    """
}

output {
    calculation <- agent.calculator
    greeting <- agent.greeter
    is_large <- agent.validator
    languages <- agent.list_generator
    summary <- agent.summary
}
