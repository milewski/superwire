provider ollama {
    driver <- "ollama"
    config <- { endpoint <- "http://100.76.5.36:11434" }
    models <- [ "qwen3:8b" ]
}

agent file_explorer {
    model <- "ollama/qwen3:8b"
    tools <- [ tool.bash ]
    output <- {
        items: [string]
    }
    prompt <- """
        You are a helpful file system assistant.
        List the files in the current directory and provide a brief summary of what you find.
        list all files on the current directory, return only the file names / folder names
        return the path as absolute path
    """
}

output {
    files <- agent.file_explorer
}
