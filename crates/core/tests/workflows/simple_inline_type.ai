provider ollama {
    driver <- "ollama"
    config <- { endpoint <- "http://100.76.5.36:11434" }
    models <- ["qwen3:8b"]
}

// Simple number output
agent add_numbers {
    model <- "ollama/qwen3:8b"
    output <- number "sum of 42 and 58"
    prompt <- "What is 42 + 58? Return only the number."
}

// Simple string output
agent create_greeting {
    model <- "ollama/qwen3:8b"
    output <- string "a short greeting"
    prompt <- "Say hello in one short sentence."
}

// Simple boolean output
agent check_value {
    model <- "ollama/qwen3:8b"
    output <- boolean "true if sum is 100, false otherwise"
    prompt <- "Is {{ agent.add_numbers }} equal to 100? Return true or false."
}

output {
    sum <- agent.add_numbers
    greeting <- agent.create_greeting
    is_hundred <- agent.check_value
}
