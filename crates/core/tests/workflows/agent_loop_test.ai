provider ollama {
    driver <- "ollama"
    config <- { endpoint: "http://100.76.5.36:11434" }
    models <- ["qwen3:8b"]
}

agent simple_test {
    model <- "ollama/qwen3:8b"

    output <- schema {
        message: string
    }

    prompt <- "Generate a simple greeting message."
}

output {
    result <- agent.simple_test
}
