provider ollama {
    driver <- "ollama"
    api_endpoint <- "http://100.76.5.36:11434"
    models <- ["qwen3:8b"]
}

schema FileList {
    files: [string;4] "exactly 4 files"
}

<- agent file_lister {
    model <- "ollama/qwen3:8b"
    output <- schema.FileList
    prompt <- "Generate a list of exactly 4 example filenames (like file1.txt, file2.txt, etc.)"
}
