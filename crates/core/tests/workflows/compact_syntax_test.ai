provider ollama {
    driver <- "ollama"
    config <- { endpoint <- "http://100.76.5.36:11434" }
    models <- ["qwen3:8b"]
}

agent one {
    model <- "ollama/qwen3:8b"

    output <- {
        message: string
    }

    prompt <- "Say hello"
}

agent two {
    model <- "ollama/qwen3:8b"

    output <- {
        message: string
    }

    prompt <- "Say goodbye"
}

output {
    single_context_summary <- compact {
        model <- "ollama/qwen3:8b"
        context <- agent.one.context
    }

    multi_context_summary <- compact {
        model <- "ollama/qwen3:8b"
        context <- [agent.one.context, agent.two.context]
    }
}
