provider ollama {
    driver <- "ollama"
    api_endpoint <- "http://100.76.5.36:11434"
    models <- ["qwen3:8b"]
}

<- agent joke {
    model <- "ollama/qwen3:8b"
    prompt <- "Tell me a short joke about programming. Just the joke, nothing else."
}

<- agent fact {
    model <- "ollama/qwen3:8b"
    prompt <- "Tell me an interesting fact about computers. Just the fact, nothing else."
}
