provider ollama {
    driver <- "ollama"
    api_endpoint <- "http://100.76.5.36:11434"
    models <- ["qwen3:8b"]
}

agent numbers {
    model <- "ollama/qwen3:8b"

    prompt <- """
        Generate a list of 3 random numbers between 1 and 10.
    """

    output <- {
        values: [number]
    }
}

<- agent doubled {
    model <- "ollama/qwen3:8b"
    
    for_each <- agent.numbers.values as num
    
    output <- number
    
    prompt <- "What is {{ input.num }} multiplied by 2?"
}

output {
    context <- agent.doubled.context
    numbers <- agent.numbers
}
