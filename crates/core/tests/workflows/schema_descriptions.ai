provider ollama {
    driver <- "ollama"
    config <- { endpoint <- "http://100.76.5.36:11434" }
    models <- ["qwen3:8b"]
}

<- agent user {
    model <- "ollama/qwen3:8b"
    
    output <- {
        username: string "Must be lowercase alphanumeric, 3-20 characters"
        email: string "Must be a valid email address"
        age: number "Must be between 13 and 120"
    }
    
    prompt <- "Generate a random user with username, email, and age following the field requirements."
}
