provider ollama {
    driver <- "ollama"
    api_endpoint <- "http://100.76.5.36:11434"
    models <- ["qwen3:8b"]
}

input {
    user_name: string
}

<- agent greeting {
    model <- "ollama/qwen3:8b"
    prompt <- "Create a friendly greeting for someone named {{ input.user_name }}. Just the greeting, nothing else."
}

output {
    user <- input.user_name
    timestamp <- "2026-03-08"
}
