provider ollama {
    driver <- "ollama"
    config <- { endpoint: "http://100.76.5.36:11434" }
    models <- ["qwen3:8b"]
}

agent conversation_start {
    model <- "ollama/qwen3:8b"
    prompt <- "Start a conversation about space exploration. Ask an interesting question."
}

<- agent conversation_continue {
    model <- "ollama/qwen3:8b"
    context <- agent.conversation_start.context
    prompt <- "Continue the conversation by answering the previous question and asking a follow-up question."
}
