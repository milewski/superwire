provider ollama1 {
    driver <- "ollama"
    api_endpoint <- "http://100.76.5.36:11434"
    models <- ["qwen3:8b"]
}

input {
    topic: string
}

agent research {
    model <- "ollama1/qwen3:8b"
    prompt <- "Research the topic: {{ input.topic }}. Provide detailed information."
}

output {
    topic <- input.topic
    research_context <- agent.research.context
    summary <- compact {
        model <- "ollama1/qwen3:8b"
        context <- agent.research.context
    }
}
