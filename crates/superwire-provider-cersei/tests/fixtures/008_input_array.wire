provider openai from openai {
    endpoint: "http://localhost:1234/v1"
    api_key: "test-api-key"
}

model openai_model from openai {
    id: "model-a"
}

input {
    items: [string]
}

agent processor {
    model: model.openai_model
    instruction: "Process these items: {{ input.items }}"
    output {
        processed: [string]
        count: number
    }
}

output {
    processed: agent.processor.processed
    count: agent.processor.count
}
