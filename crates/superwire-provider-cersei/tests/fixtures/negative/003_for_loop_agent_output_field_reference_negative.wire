provider openai from openai {
    api_key: "test-api-key"
}

model openai_model from openai {
    id: "test-model"
}

agent random for number in [1, 2, 3, 4, 5] {
    model: model.openai_model
    instruction: "Give me a random user name and age, the name should start / be prefixed with {{ number }}"
    output {
        user: (string, number)
    }
}

agent surname {
    model: model.openai_model
    instruction: "Give a surname to this user {{ agent.random.user }}"
    output {
        surname: string
    }
}

output {
    surname: agent.surname.surname
}
