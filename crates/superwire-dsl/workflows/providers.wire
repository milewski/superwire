provider anthropic from anthropic {
}

model anthropic_model from anthropic {
    id: "claude-sonnet-4-6"
}

provider openai from openai {
}

model openai_model from openai {
    id: "gpt-4o"
}

provider google from google {
}

model google_model from google {
    id: "gemini-2.0-flash"
}

provider mistral from mistral {
}

model mistral_model from mistral {
    id: "mistral-large-latest"
}

provider groq from groq {
}

model groq_model from groq {
    id: "llama-3.1-70b-versatile"
}

provider deepseek from deepseek {
}

model deepseek_model from deepseek {
    id: "deepseek-chat"
}

provider xai from xai {
}

model xai_model from xai {
    id: "grok-2"
}

provider together from together {
}

model together_model from together {
    id: "meta-llama/Meta-Llama-3.1-70B-Instruct-Turbo"
}

provider fireworks from fireworks {
}

model fireworks_model from fireworks {
    id: "accounts/fireworks/models/llama-v3p1-70b-instruct"
}

provider perplexity from perplexity {
}

model perplexity_model from perplexity {
    id: "llama-3.1-sonar-large-128k-online"
}

provider cerebras from cerebras {
}

model cerebras_model from cerebras {
    id: "llama3.1-70b"
}

provider ollama from ollama {
}

model ollama_model from ollama {
    id: "llama3.1"
}

provider openrouter from openrouter {
}

model openrouter_model from openrouter {
    id: "anthropic/claude-3.5-sonnet"
}

provider cohere from cohere {
}

model cohere_model from cohere {
    id: "command-r-plus"
}

provider sambanova from sambanova {
}

model sambanova_model from sambanova {
    id: "Meta-Llama-3.1-70B-Instruct"
}

provider custom_openai from openai_compatible {
    endpoint: "http://localhost:8080/v1"
    api_key: "custom-openai-key"
}

model custom_openai_model from custom_openai {
    id: "custom-openai-model"
}

provider custom_anthropic from anthropic_compatible {
    endpoint: "http://localhost:8081"
    api_key: "custom-anthropic-key"
}

model custom_anthropic_model from custom_anthropic {
    id: "custom-anthropic-model"
}

output {
    ok: true
}
