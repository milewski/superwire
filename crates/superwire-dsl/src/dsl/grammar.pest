workflow = { SOI ~ declaration* ~ EOI }

declaration = _{
    provider_declaration
    | model_declaration
    | mcp_declaration
    | secrets_declaration
    | input_declaration
    | schema_declaration
    | mcp_tool_batch_import_declaration
    | mcp_resource_batch_import_declaration
    | mcp_prompt_batch_import_declaration
    | mcp_batch_import_declaration
    | tool_import_declaration
    | resource_import_declaration
    | prompt_import_declaration
    | tool_block_declaration
    | dynamic_declaration
    | agent_declaration
    | output_declaration
}

provider_declaration = { "provider" ~ identifier ~ "from" ~ identifier ~ config_block }
model_declaration = { "model" ~ identifier ~ "from" ~ identifier ~ config_block }
config_block = { "{" ~ config_property* ~ "}" }
config_property = _{ named_object_property | object_field }
mcp_declaration = { "mcp" ~ identifier ~ mcp_server_block }
mcp_server_block = { "{" ~ mcp_server_property* ~ "}" }
mcp_server_property = _{ named_object_property | object_field }
secrets_declaration = { "secrets" ~ typed_block }
input_declaration = { "input" ~ typed_block }
schema_declaration = { "schema" ~ identifier ~ schema_body }
schema_body = _{ typed_block | object_level_variant_type }
tool_block_declaration = { "tool" ~ identifier ~ tool_block }
tool_import_declaration = { "tool" ~ ("from" | identifier ~ "from") ~ mcp_import_reference ~ tool_import_block? }
resource_import_declaration = { "resource" ~ ("from" | identifier ~ "from") ~ mcp_import_reference ~ mcp_import_block? }
prompt_import_declaration = { "prompt" ~ ("from" | identifier ~ "from") ~ mcp_import_reference ~ mcp_import_block? }

mcp_tool_batch_import_declaration = { "from" ~ mcp_tool_batch_import_source ~ mcp_tool_batch_import_block }
mcp_tool_batch_import_source = { "mcp" ~ "." ~ identifier ~ "." ~ "tool" }
mcp_tool_batch_import_block = { "{" ~ mcp_tool_batch_import_property* ~ "}" }
mcp_tool_batch_import_property = _{ named_tool_block_property | named_object_property | named_unsigned_integer_property | mcp_tool_batch_import_item }
mcp_tool_batch_import_item = { "tool" ~ mcp_import_name ~ ("as" ~ identifier)? ~ tool_import_block? }

mcp_resource_batch_import_declaration = { "from" ~ mcp_resource_batch_import_source ~ mcp_resource_batch_import_block }
mcp_resource_batch_import_source = { "mcp" ~ "." ~ identifier ~ "." ~ "resource" }
mcp_resource_batch_import_block = { "{" ~ mcp_resource_batch_import_property* ~ "}" }
mcp_resource_batch_import_property = _{ named_object_property | mcp_resource_batch_import_item }
mcp_resource_batch_import_item = { "resource" ~ mcp_import_name ~ ("as" ~ identifier)? ~ mcp_import_block? }

mcp_prompt_batch_import_declaration = { "from" ~ mcp_prompt_batch_import_source ~ mcp_prompt_batch_import_block }
mcp_prompt_batch_import_source = { "mcp" ~ "." ~ identifier ~ "." ~ "prompt" }
mcp_prompt_batch_import_block = { "{" ~ mcp_prompt_batch_import_property* ~ "}" }
mcp_prompt_batch_import_property = _{ named_object_property | mcp_prompt_batch_import_item }
mcp_prompt_batch_import_item = { "prompt" ~ mcp_import_name ~ ("as" ~ identifier)? ~ mcp_import_block? }

mcp_batch_import_declaration = { "from" ~ mcp_batch_import_source ~ mcp_batch_import_block }
mcp_batch_import_source = { "mcp" ~ "." ~ identifier }
mcp_batch_import_block = { "{" ~ mcp_batch_import_property* ~ "}" }
mcp_batch_import_property = _{ named_object_property | named_tool_block_property | named_unsigned_integer_property | mcp_resource_batch_import_item | mcp_prompt_batch_import_item | mcp_tool_batch_import_item }

tool_import_block = { "{" ~ tool_import_property* ~ "}" }
tool_import_property = _{ named_tool_block_property | named_object_property | named_unsigned_integer_property }

mcp_import_reference = { "mcp" ~ "." ~ identifier ~ "." ~ mcp_import_kind ~ "." ~ mcp_import_name }
mcp_import_kind = { "tool" | "resource" | "prompt" }
mcp_import_name = { mcp_tool_name }
mcp_import_block = { "{" ~ mcp_import_property* ~ "}" }
mcp_import_property = _{ named_object_property }

tool_block = { "{" ~ tool_property* ~ "}" }
tool_property = _{ named_plain_string_property | named_unsigned_integer_property | named_tool_block_property | tool_input_field }
named_tool_block_property = { identifier ~ tool_bindings_block }
tool_input_field = { typed_field }
mcp_tool_name = @{ (ASCII_ALPHA | ASCII_DIGIT | "_")+ ~ ("-" ~ (ASCII_ALPHA | ASCII_DIGIT | "_")+)* }

dynamic_declaration = { "dynamic" ~ object_expression }

agent_declaration = { "agent" ~ identifier ~ for_clause? ~ agent_block }
for_clause = { "for" ~ for_loop_pattern ~ "in" ~ expression }
for_loop_pattern = { identifier | object_destructuring_pattern }
object_destructuring_pattern = { "{" ~ identifier ~ ("," ~ identifier)* ~ ","? ~ "}" }
agent_block = { "{" ~ agent_property* ~ "}" }
agent_property = _{ model_agent_property | agent_output_property | named_agent_context_property | named_object_property | named_agent_value_property }
model_agent_property = { "model" ~ ":" ~ model_usage }
agent_output_property = { "output" ~ typed_block }
named_agent_context_property = { "context" ~ ":" ~ agent_context_value }
named_agent_value_property = { identifier ~ ":" ~ agent_property_value }
agent_property_value = _{ tools_expression | response_format_value | expression | type_expression }
agent_context_value = _{ compact_agent_context | explicit_agent_context | reference }
explicit_agent_context = { "context" ~ reference }
compact_agent_context = { "compact" ~ reference ~ agent_context_block? }
agent_context_block = { "{" ~ agent_context_property* ~ "}" }
agent_context_property = _{ object_field }
response_format_value = { "auto" | "json_schema" | "json_object" | "instruction_only" }

tools_expression = { "[" ~ (agent_tool_binding ~ ("," ~ agent_tool_binding)* ~ ","?)? ~ "]" }
agent_tool_binding = { reference ~ agent_tool_binding_block? }
agent_tool_binding_block = { "{" ~ agent_tool_binding_property* ~ "}" }
agent_tool_binding_property = _{ named_object_property | named_unsigned_integer_property }

model_usage = { reference ~ model_usage_block? }
model_usage_block = { "{" ~ model_usage_property* ~ "}" }
model_usage_property = _{ named_object_property | object_field }

output_declaration = { "output" ~ object_expression }

typed_block = { "{" ~ typed_field* ~ "}" }
typed_field = { doc_comment* ~ identifier ~ ":" ~ type_expression ~ ","? }

tool_bindings_block = { "{" ~ tool_binding_field* ~ "}" }
tool_binding_field = { doc_comment* ~ identifier ~ ":" ~ (tool_binding_type_expression | expression) ~ ","? }
tool_binding_type_expression = { tool_binding_type_term ~ ("|" ~ tool_binding_type_term)* }
tool_binding_type_object = { "{" ~ typed_field* ~ "}" }
tool_binding_type_term = _{
    nullable_type
    | enum_type
    | variant_type
    | scalar_type
    | schema_reference
    | reference
    | plain_string_literal
    | array_type
    | tuple_type
    | tool_binding_type_object
}

type_expression = { type_term ~ ("|" ~ type_term)* }

type_term = _{
    nullable_type
    | enum_type
    | variant_type
    | scalar_type
    | schema_reference
    | reference
    | array_type
    | tuple_type
    | type_object
    | plain_string_literal
}

scalar_type = { "string" | "number" | "float" | "boolean" | "object" }
nullable_type = { "maybe" ~ type_term }
enum_type = { "enum" ~ "{" ~ enum_case* ~ "}" }
enum_case = { identifier ~ ","? }
variant_type = { "variant" ~ identifier ~ "{" ~ variant_case* ~ "}" }
object_level_variant_type = { "{" ~ variant_type ~ "}" }
variant_case = { variant_case_label ~ type_object }
variant_case_label = { identifier | plain_string_literal }
schema_reference = { "schema" ~ "." ~ identifier ~ !("." ~ identifier) }
array_type = { "[" ~ type_expression ~ (";" ~ unsigned_integer_literal)? ~ "]" }
tuple_type = { "(" ~ type_expression ~ ("," ~ type_expression)* ~ ")" }
type_object = { "{" ~ typed_field* ~ "}" }

expression = _{ fallback_expression }
fallback_expression = { expression_primary ~ ("??" ~ expression_primary)? }
expression_primary = _{
    match_expression
    | variant_projection_expression
    | agent_context_expression
    | asset_expression
    | tool_call_expression
    | mcp_call_expression
    | function_call
    | object_expression
    | array_expression
    | boolean_literal
    | null_literal
    | number_literal
    | string_expression
    | reference
}
match_expression = { "match" ~ expression ~ "{" ~ match_branch* ~ "}" }
match_branch = _{ match_fallback_branch | match_variant_branch }
match_fallback_branch = { "_" ~ expression }
match_variant_branch = { variant_case_label ~ ("." ~ identifier)* }
variant_projection_expression = { reference ~ "#" ~ identifier ~ ("." ~ identifier)* }

agent_context_expression = { explicit_agent_context | compact_agent_context }
asset_expression = { "asset" ~ expression_primary ~ asset_block? }
asset_block = { "{" ~ asset_property* ~ "}" }
asset_property = _{ object_field }

tool_call_expression = { "call" ~ reference ~ tool_call_block? }
tool_call_block = { "{" ~ tool_call_property* ~ "}" }
tool_call_property = _{ named_object_property | named_unsigned_integer_property }

mcp_call_expression = { mcp_call_keyword ~ reference ~ mcp_call_block? }
mcp_call_keyword = { "read" | "render" }
mcp_call_block = { "{" ~ mcp_call_property* ~ "}" }
mcp_call_property = _{ named_object_property }

named_object_property = { identifier ~ object_expression }
named_plain_string_property = { identifier ~ ":" ~ plain_string_literal }
named_unsigned_integer_property = { identifier ~ ":" ~ unsigned_integer_literal }

object_expression = { "{" ~ object_field* ~ "}" }
object_field = { object_field_name ~ ":" ~ expression }
object_field_name = { identifier | plain_string_literal }

array_expression = { "[" ~ (expression ~ ("," ~ expression)* ~ ","?)? ~ "]" }

function_call = { reference ~ "(" ~ call_arguments? ~ ")" }
call_arguments = { call_argument ~ ("," ~ call_argument)* ~ ","? }
call_argument = { named_argument | expression }
named_argument = { identifier ~ ":" ~ expression }

reference = { identifier ~ (reference_operator ~ identifier)* }
reference_operator = { ".***." | ".**." | ".*." | "?." | "." }

boolean_literal = { "true" | "false" }
null_literal = { "null" }
number_literal = @{ "-"? ~ ASCII_DIGIT ~ (ASCII_DIGIT | "_")* ~ ("." ~ ASCII_DIGIT ~ (ASCII_DIGIT | "_")*)? }
unsigned_integer_literal = @{ ASCII_DIGIT ~ (ASCII_DIGIT | "_")* }

escaped_character = { "\\\\" | "\\\"" | "\\n" | "\\r" | "\\t" | "\\{" | "\\}" }

string_expression = { multiline_string_expression | quoted_string_expression }

quoted_string_expression = ${ "\"" ~ quoted_string_part* ~ "\"" }
quoted_string_part = { interpolation | escaped_character | quoted_string_text }
quoted_string_text = @{ (!("\"" | "\\" | "{" | "}" | NEWLINE) ~ ANY)+ }

multiline_string_expression = ${ "\"\"\"" ~ multiline_string_part* ~ "\"\"\"" }
multiline_string_part = { interpolation | escaped_character | multiline_string_text }
multiline_string_text = @{ (!("\"\"\"" | "\\" | "{" | "}") ~ ANY)+ }

interpolation = !{ "{{" ~ WHITESPACE* ~ expression ~ WHITESPACE* ~ "}}" }

plain_string_literal = _{ plain_multiline_string | plain_quoted_string }
plain_quoted_string = @{ "\"" ~ (escaped_character | !("\"" | NEWLINE) ~ ANY)* ~ "\"" }
plain_multiline_string = @{ "\"\"\"" ~ (!("\"\"\"") ~ ANY)* ~ "\"\"\"" }

identifier = @{ (ASCII_ALPHA | "_") ~ (ASCII_ALPHANUMERIC | "_")* }
doc_comment = @{ "///" ~ (!NEWLINE ~ ANY)* }

WHITESPACE = _{ " " | "\t" | NEWLINE }
COMMENT = _{ "//" ~ !"/" ~ (!NEWLINE ~ ANY)* }
