provider ollama1 {
    driver <- "ollama"
    api_endpoint <- "http://100.76.5.36:11434"
    models <- ["qwen3.5:27b"]
}

schema person {
    name: string
    age: number
}

agent generate_person {
    model <- "ollama1/qwen3.5:27b"
    output <- schema.person
    prompt <- """
        Generate a fictional person.
        Return ONLY a JSON object with name (string) and age (number).
    """
}

<- agent greet_person {
    model <- "ollama1/qwen3.5:27b"
    prompt <- """
        Write a friendly greeting for {{ generate_person.name }} who is {{ generate_person.age }} years old.
        Keep it to one sentence.
    """
}
