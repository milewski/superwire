provider ollama1 {
    driver <- "ollama"
    api_endpoint <- "http://100.76.5.36:11434"
    models <- ["qwen3.5:27b"]
}

schema product {
    name: string "Product name"
    price: number "Price in USD"
    in_stock: boolean "Whether the product is in stock"
    category: "electronics" | "books" | "clothing"
    tags: [string] "Product tags"
}

<- agent create_product {
    model <- "ollama1/qwen3.5:27b"
    output <- schema.product
    prompt <- """
        Create a fictional product for a laptop.
        Return ONLY a JSON object with:
        - name (string)
        - price (number)
        - in_stock (boolean)
        - category (must be "electronics", "books", or "clothing")
        - tags (array of strings)
    """
}
