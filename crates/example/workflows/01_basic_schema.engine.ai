provider ollama1 {
    driver <- "ollama"
    api_endpoint <- "http://100.76.5.36:11434"
    models <- ["qwen3.5:27b"]
}

schema task {
    title: string "The task title"
    priority: "low" | "medium" | "high"
    completed: boolean
}

<- agent create_task {
    model <- "ollama1/qwen3.5:27b"
    output <- schema.task
    prompt <- """
        Create a task for organizing a team meeting.
        Return ONLY a JSON object with title, priority (low/medium/high), and completed (boolean).
    """
}
