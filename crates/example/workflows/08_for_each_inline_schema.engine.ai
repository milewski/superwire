provider ollama1 {
    driver <- "ollama"
    api_endpoint <- "http://100.76.5.36:11434"
    models <- ["qwen3.5:27b"]
}

<- agent calculate {
    model <- "ollama1/qwen3.5:27b"
    for_each <- [5, 10, 15, 20] as number
    output <- schema {
        input: number
        doubled: number
    }
    prompt <- """
        Double the number {{ number }}.
        Return ONLY a JSON object with "input" (the original number) and "doubled" (the result).
    """
}
