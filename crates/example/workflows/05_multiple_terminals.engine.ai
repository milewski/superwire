provider ollama1 {
    driver <- "ollama"
    api_endpoint <- "http://100.76.5.36:11434"
    models <- ["qwen3.5:27b"]
}

<- agent poem {
    model <- "ollama1/qwen3.5:27b"
    prompt <- """
        Write a haiku about coding.
    """
}

<- agent joke {
    model <- "ollama1/qwen3.5:27b"
    prompt <- """
        Tell a short programming joke.
    """
}
