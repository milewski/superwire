provider ollama1 {
    driver <- "ollama"
    api_endpoint <- "http://100.76.5.36:11434"
    models <- ["qwen3.5:27b"]
}

schema color_list {
    colors: [string]
}

agent list_colors {
    model <- "ollama1/qwen3.5:27b"
    output <- schema.color_list
    prompt <- """
        List 3 primary colors.
        Return ONLY a JSON object with a "colors" array of strings.
    """
}

<- agent describe_colors {
    model <- "ollama1/qwen3.5:27b"
    for_each <- list_colors.colors as color
    prompt <- """
        Describe the color {{ color }} in one short sentence.
    """
}
