provider ollama1 {
    driver <- "ollama"
    api_endpoint <- "http://100.76.5.36:11434"
    models <- ["qwen3.5:27b"]
}

input {
    topic: string "Topic to summarize"
    audience: string "Audience for the final summary"
}

schema person {
    name: string "Full name"
    hobbies: [string] "List of hobbies"
}

agent collect_person {
    model <- "ollama1/qwen3.5:27b"
    output <- schema.person
    prompt <- "Return a JSON object describing a fictional person whose interests relate to {{ input.topic }}."
}

agent summarize_person {
    model <- "ollama1/qwen3.5:27b"
    context <- agent.collect_person.context.summary
    prompt <- "Summarize the generated person for a {{ input.audience }} audience in one short paragraph."
}

output {
    requested_topic <- input.topic
    requested_audience <- input.audience
    person_name <- collect_person.name
    context <- agent.collect_person.context
    summary <- agent.collect_person.context.summary
}