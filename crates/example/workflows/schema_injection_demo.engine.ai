provider ollama1 {
    driver <- "ollama"
    api_endpoint <- "http://100.76.5.36:11434"
    models <- ["qwen3.5:27b"]
}

schema user_profile {
    username: string "The username, must be lowercase alphanumeric"
    email: string "Valid email address"
    age: number "Age in years, must be positive"
    role: "admin" | "user" | "guest"
    active: boolean
    tags: [string]
}

<- agent create_profile {
    model <- "ollama1/qwen3.5:27b"
    output <- schema.user_profile
    prompt <- """
        Create a user profile for a new software developer joining the team.
        The developer is 28 years old and should have admin access.
    """
}
