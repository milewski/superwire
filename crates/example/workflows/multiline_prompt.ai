provider ollama1 {
    driver <- "ollama"
    api_endpoint <- "http://100.76.5.36:11434"
    models <- ["qwen3:8b"]
}

<- agent story {
    model <- "ollama1/qwen3:8b"
    
    prompt <- """
        Write a very short story about a robot learning to paint.
        Keep it under 100 words.
        Make it inspiring and creative.
    """
}
