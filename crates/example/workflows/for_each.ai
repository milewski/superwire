provider ollama1 {
    driver <- "ollama"
    api_endpoint <- "http://100.76.5.36:11434"
    models <- ["qwen3:8b"]
}

agent numbers {
    model <- "ollama1/qwen3:8b"
    
    output <- {
        values: [number]
    }
    
    prompt <- "Generate a list of 3 random numbers between 1 and 10."
}

<- agent doubled {
    model <- "ollama1/qwen3:8b"
    
    for_each <- agent.numbers.values as num
    
    output <- {
        result: number
    }
    
    prompt <- "What is {{ input.num }} multiplied by 2? Reply with just the number in JSON format."
}
