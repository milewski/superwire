provider ollama1 {
    driver <- "ollama"
    api_endpoint <- "http://100.76.5.36:11434"
    models <- ["qwen3.5:27b"]
}

schema person {
    name: string "Full name"
    hobbies: [string] "List of hobbies"
}

agent collect_person {
    model <- "ollama1/qwen3.5:27b"
    output <- schema.person
    prompt <- "Return a JSON object describing a fictional person."
}

<- agent summarize_person {
    model <- "ollama1/qwen3.5:27b"
    context <- agent.collect_person.context.summary
    prompt <- "Summarize the generated person in one short paragraph."
}
