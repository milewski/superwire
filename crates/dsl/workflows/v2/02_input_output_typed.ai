// Real use case: release readiness risk brief for a production deploy.
// Demonstrates typed input + reusable schema + typed final output.

provider openai {
    driver: "openai"
    endpoint: env("OPENAI_BASE_URL", default: "http://127.0.0.1:1234/v1")
    models: ["qwen3.5-27b"]
}

input ReleaseInput {
    service:: string
    release_version:: string
    change_summary:: string
    known_risks:: [string]
    target_region:: "us" | "eu" | "global"
}

schema ReleaseRiskAssessment {
    go_no_go:: "go" | "hold"
    risk_level:: "low" | "medium" | "high"
    critical_risks:: [string]
    rollout_plan:: [string]
    rollback_plan:: [string]
}

agent release_analyst {
    model: openai("qwen3.5-27b")

    inference: {
        temperature: 0.2
        max_tokens: 12_000
    }

    prompt: "You are a senior release manager. Service={{ input.service }}, version={{ input.release_version }}, region={{ input.target_region }}, changes={{ input.change_summary }}, known_risks={{ input.known_risks }}. Produce a strict go/no-go assessment."
    output: schema ReleaseRiskAssessment
}

output ReleaseDecision {
    service <- input.service
    release_version <- input.release_version
    target_region <- input.target_region
    go_no_go <- agent.release_analyst.output.go_no_go
    risk_level <- agent.release_analyst.output.risk_level
    critical_risks <- agent.release_analyst.output.critical_risks
    rollout_plan <- agent.release_analyst.output.rollout_plan
    rollback_plan <- agent.release_analyst.output.rollback_plan
}
