// Real use case: status page update generation with robust fallback handling.

// Provider shared by all generation agents.
provider openai {
    driver: "openai"
    endpoint: env("OPENAI_BASE_URL", default: "http://127.0.0.1:1234/v1")
    models: ["qwen3.5-27b"]
}

// Input payload from incident management service.
input {
    incident_title:: string
    impact:: string
}

// Primary writer attempts a high-quality detailed customer update.
agent primary_status_writer {
    model: openai("qwen3.5-27b")
    on_error: "continue_with_fallback"
    retries: 1

    prompt: "Write a detailed status page update. Incident={{ input.incident_title }}, impact={{ input.impact }}"
    output: schema {
        text:: string
    }
}

// Fallback agent executes only when the primary fails.
agent fallback_status_writer runs_if failed(primary_status_writer) {
    model: openai("qwen3.5-27b")

    prompt: "Write a concise safe status update. Incident={{ input.incident_title }}, impact={{ input.impact }}"
    output: schema {
        text:: string
    }
}

// Finalizer always normalizes whichever text is available.
agent status_editor {
    model: openai("qwen3.5-27b")

    prompt: "Normalize style for this text: {{ coalesce(agent.primary_status_writer.output.text, agent.fallback_status_writer.output.text) }}"
    output: schema {
        text:: string
    }
}

// Output returns both content and path taken.
output {
    text <- agent.status_editor.output.text
    source <- if failed(primary_status_writer) then "fallback" else "primary"
}
