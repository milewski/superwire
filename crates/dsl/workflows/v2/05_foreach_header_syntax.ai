// Real use case: convert one vulnerability scan into per-finding remediation tasks.

// Provider used by both list generation and per-item processing.
provider ollama {
    driver: "ollama"
    endpoint: env("OLLAMA_ENDPOINT", default: "http://127.0.0.1:11434")
    models: ["qwen3:8b"]
}

// Raw scanner output that needs structured planning.
input {
    scan_report:: string
}

// Stage 1: normalize scan text into a structured finding list.
agent findings {
    model: ollama("qwen3:8b")

    prompt: "Parse this scanner report into finding IDs and short descriptions: {{ input.scan_report }}"
    output: schema {
        items:: [string]
    }
}

// Stage 2: for each finding, produce a concrete remediation plan.
agent remediation_plans for finding in agent.findings.output.items {
    model: ollama("qwen3:8b")

    prompt: "Create a remediation plan for finding: {{ finding }}"
    output: schema {
        title:: string
        steps:: [string]
        owner_team:: string
        priority:: "p0" | "p1" | "p2" | "p3"
    }
}

output {
    findings <- agent.findings.output.items
    remediation_plans <- agent.remediation_plans.output
    planning_context <- agent.remediation_plans.context
}
