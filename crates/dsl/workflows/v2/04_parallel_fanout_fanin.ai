// Real use case: one input source, many content artifacts in parallel,
// then a final consistency pass before publishing.

// Shared provider for all agents in this example.
provider openai {
    driver: "openai"
    endpoint: env("OPENAI_BASE_URL", default: "http://127.0.0.1:1234/v1")
    models: ["qwen3.5-27b"]
}

input {
    product_name:: string
    release_highlights:: [string]
}

// Artifact 1: changelog entry.
agent changelog {
    model: openai("qwen3.5-27b")

    prompt: "Write release notes for {{ input.product_name }} based on highlights: {{ input.release_highlights }}"
    output: schema {
        markdown:: string
    }
}

// Artifact 2: social post thread.
agent social_thread {
    model: openai("qwen3.5-27b")

    prompt: "Create a 5-post launch thread for {{ input.product_name }} using: {{ input.release_highlights }}"
    output: schema {
        posts:: [string;5]
    }
}

// Artifact 3: customer email.
agent customer_email {
    model: openai("qwen3.5-27b")

    prompt: "Write a customer announcement email for {{ input.product_name }} with these highlights: {{ input.release_highlights }}"
    output: schema {
        subject:: string
        body:: string
    }
}

// Fan-in validation: enforce tone/terminology consistency across artifacts.
agent brand_consistency depends_on [changelog, social_thread, customer_email] {
    model: openai("qwen3.5-27b")

    prompt: "Ensure these assets are consistent in claims and tone. changelog={{ agent.changelog.output.markdown }}, thread={{ agent.social_thread.output.posts }}, email_subject={{ agent.customer_email.output.subject }}, email_body={{ agent.customer_email.output.body }}"
    output: schema {
        approved:: boolean
        issues:: [string]
    }
}

output {
    changelog_markdown <- agent.changelog.output.markdown
    social_posts <- agent.social_thread.output.posts
    email_subject <- agent.customer_email.output.subject
    email_body <- agent.customer_email.output.body
    approved <- agent.brand_consistency.output.approved
    consistency_issues <- agent.brand_consistency.output.issues
}
