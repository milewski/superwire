// Real use case: vulnerability triage using external tools.

// Provider used by tool-calling agents.
provider openai {
    driver: "openai"
    endpoint: env("OPENAI_BASE_URL", default: "http://127.0.0.1:1234/v1")
    models: ["gpt-4.1-mini"]
}

// Tool 1: CVE data fetcher from vulnerability intelligence source.
tool cve_lookup {
    input schema {
        cve_id:: string
    }

    output schema {
        description:: string
        published_date:: string
        affected_products:: [string]
    }
}

// Tool 2: converts base score and environmental modifiers into adjusted severity.
tool cvss_adjuster {
    input schema {
        base_score:: number
        internet_exposed:: boolean
        has_known_exploit:: boolean
    }

    output schema {
        adjusted_score:: number
        severity:: "low" | "medium" | "high" | "critical"
    }
}

// Workflow input schema.
input {
    cve_ids:: [string]
    environment:: "prod" | "staging"
}

// First agent resolves structured CVE context.
agent intelligence {
    model: openai("gpt-4.1-mini")
    tools: [cve_lookup]

    prompt: "For each CVE in {{ input.cve_ids }}, call cve_lookup and summarize impact for {{ input.environment }}"

    output: schema {
        findings:: [
            {
                cve_id:: string
                impact_summary:: string
                base_score:: number
            }
        ]
    }
}

// Second agent computes adjusted severity with explicit calculator tool.
agent risk_scoring {
    model: openai("gpt-4.1-mini")
    tools: [cvss_adjuster]

    prompt: "For each finding in {{ agent.intelligence.output.findings }}, call cvss_adjuster and return final prioritization"

    output: schema {
        prioritized_findings:: [
            {
                cve_id:: string
                adjusted_score:: number
                severity:: "low" | "medium" | "high" | "critical"
                rationale:: string
            }
        ]
    }
}

output {
    findings <- agent.intelligence.output.findings
    prioritized_findings <- agent.risk_scoring.output.prioritized_findings
}
