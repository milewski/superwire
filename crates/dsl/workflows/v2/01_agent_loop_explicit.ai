// Real use case: generate an on-call incident digest from raw event lines.
// This is the minimal, single-agent baseline for the language.

// Provider setup for local inference.
provider ollama {
    driver: "ollama"
    endpoint: env("OLLAMA_ENDPOINT", default: "http://127.0.0.1:11434")
    models: ["qwen3.5:8b", "qwen3.5:27b"]
}

// Workflow input from incident tooling.
input {
    incident_id:: string
    service:: string
    recent_events:: [string]
}

// Agent transforms noisy timeline into actionable triage summary.
agent incident_digest {
    model: ollama("qwen3.5:8b")

    // Fast model + deterministic-ish settings for operational output.
    inference: {
        temperature: 0.4
        max_tokens: 8_000
    }

    prompt: "You are an SRE assistant. Incident {{ input.incident_id }} for {{ input.service }} has these events: {{ input.recent_events }}. Return concise triage guidance."

    // Typed output contract keeps downstream automation stable.
    output: schema {
        summary:: string
        likely_root_cause:: string
        immediate_actions:: [string]
    }
}

// Final projection consumed by paging UI / Slack notifier.
output {
    incident_id <- input.incident_id
    service <- input.service
    summary <- agent.incident_digest.output.summary
    likely_root_cause <- agent.incident_digest.output.likely_root_cause
    immediate_actions <- agent.incident_digest.output.immediate_actions
}
