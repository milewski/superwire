// Real use case: draft a postmortem using a shared markdown template.

// Provider configuration for this workflow.
provider openai {
    driver: "openai"
    endpoint: env("OPENAI_BASE_URL", default: "http://127.0.0.1:1234/v1")
    models: ["qwen3.5-27b"]
}

input {
    incident_id:: string
    service:: string
    impact_summary:: string
    timeline_events:: [string]
    mitigation_actions:: [string]
}

// Prompt template can live in repo and be reused by many workflows.
agent postmortem_writer {
    model: openai("qwen3.5-27b")

    prompt template "prompts/postmortem.md" with {
        incident_id: input.incident_id
        service: input.service
        impact_summary: input.impact_summary
        timeline_events: input.timeline_events
        mitigation_actions: input.mitigation_actions
    }

    output: schema {
        title:: string
        executive_summary:: string
        root_cause:: string
        follow_up_actions:: [string]
    }
}

output {
    incident_id <- input.incident_id
    title <- agent.postmortem_writer.output.title
    executive_summary <- agent.postmortem_writer.output.executive_summary
    root_cause <- agent.postmortem_writer.output.root_cause
    follow_up_actions <- agent.postmortem_writer.output.follow_up_actions
}
