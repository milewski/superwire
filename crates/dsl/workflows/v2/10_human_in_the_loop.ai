// Real use case: customer-facing comms must pass legal approval before publish.

// Provider configuration.
provider openai {
    driver: "openai"
    endpoint: env("OPENAI_BASE_URL", default: "http://127.0.0.1:1234/v1")
    models: ["qwen3.5-27b"]
}

// Input payload from incident/comms tooling.
input {
    incident_summary:: string
    affected_customers:: string
}

// Agent drafts initial external communication.
agent draft_customer_message {
    model: openai("qwen3.5-27b")

    prompt: "Draft a customer incident update. Incident={{ input.incident_summary }}, affected={{ input.affected_customers }}"
    output: schema {
        content:: string
    }
}

// Human checkpoint pauses the flow until decision is made.
checkpoint legal_review {
    prompt: "Approve this draft?"
    payload: agent.draft_customer_message.output.content
    timeout: "24h"
    on_timeout: "reject"
}

// This agent runs only if checkpoint is approved.
agent publish when checkpoint.legal_review == "approved" {
    model: openai("qwen3.5-27b")

    prompt: "Format for publication: {{ agent.draft_customer_message.output.content }}"
    output: schema {
        published:: string
    }
}

// Output includes final status and optional publication result.
output {
    status <- checkpoint.legal_review
    published <- coalesce(agent.publish.output.published, null)
}
