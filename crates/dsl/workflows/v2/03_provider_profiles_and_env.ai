// Real use case: customer support reply pipeline with local PII scrubbing
// followed by higher-quality cloud response generation.

provider local_ollama {
    driver: "ollama"
    endpoint: env("OLLAMA_ENDPOINT", default: "http://127.0.0.1:11434")
    models: ["qwen3:8b", "qwen3:14b"]
}

provider cloud_openai {
    driver: "openai"
    endpoint: env("OPENAI_BASE_URL", default: "https://api.openai.com/v1")
    api_key: env("OPENAI_API_KEY")
    models: ["gpt-4.1-mini", "gpt-4.1"]
}

input {
    ticket_id:: string
    customer_message:: string
    product_area:: string
    account_tier:: "free" | "pro" | "enterprise"
}

// First stage: sanitize and normalize raw customer text locally.
agent sanitize_ticket {
    model: local_ollama("qwen3:14b")

    prompt: "Remove PII and normalize this ticket text while preserving intent: {{ input.customer_message }}"
    output: schema {
        sanitized_message:: string
        pii_found:: boolean
        pii_categories:: [string]
    }
}

// Second stage: generate a polished reply using cloud model.
agent draft_reply {
    model: cloud_openai("gpt-4.1")

    prompt: "Ticket={{ input.ticket_id }}, product={{ input.product_area }}, tier={{ input.account_tier }}, message={{ agent.sanitize_ticket.output.sanitized_message }}. Draft a helpful support response and next steps."
    output: schema {
        response:: string
        next_steps:: [string]
        escalation_needed:: boolean
    }
}

output {
    ticket_id <- input.ticket_id
    sanitized <- agent.sanitize_ticket.output.sanitized_message
    pii_found <- agent.sanitize_ticket.output.pii_found
    pii_categories <- agent.sanitize_ticket.output.pii_categories
    response <- agent.draft_reply.output.response
    next_steps <- agent.draft_reply.output.next_steps
    escalation_needed <- agent.draft_reply.output.escalation_needed
}
