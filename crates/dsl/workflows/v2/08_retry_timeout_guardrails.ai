// Real use case: enterprise RFP response generation with strict runtime guardrails.

// Provider used by both agents.
provider openai {
    driver: "openai"
    endpoint: env("OPENAI_BASE_URL", default: "http://127.0.0.1:1234/v1")
    models: ["qwen3.5-27b"]
}

// Global execution defaults applied unless overridden per agent.
policy {
    max_parallel_agents: 4
    default_timeout: "45s"
    default_retries: 2
}

// Input contract for proposal generation.
input {
    company_name:: string
    rfp_requirements:: [string]
    deadline_utc:: string
}

// Expensive phase: gather requirement-level analysis and identify gaps.
agent requirements_analysis {
    model: openai("qwen3.5-27b")
    timeout: "90s"
    retries: 3

    prompt: "Analyze these RFP requirements for {{ input.company_name }}: {{ input.rfp_requirements }}. Return compliance coverage guidance and risk gaps."
    output: schema {
        requirement_briefs:: [string]
        risk_gaps:: [string]
    }
}

// Faster phase: synthesize executive response from analysis output.
agent executive_response {
    model: openai("qwen3.5-27b")
    timeout: "30s"
    retries: 1

    prompt: "Draft a concise executive response for {{ input.company_name }}. Requirement briefs={{ agent.requirements_analysis.output.requirement_briefs }}, gaps={{ agent.requirements_analysis.output.risk_gaps }}, deadline={{ input.deadline_utc }}"
    output: schema {
        executive_summary:: string
        top_commitments:: [string]
    }
}

// Final payload for sales/review workflow.
output {
    company_name <- input.company_name
    executive_summary <- agent.executive_response.output.executive_summary
    top_commitments <- agent.executive_response.output.top_commitments
    risk_gaps <- agent.requirements_analysis.output.risk_gaps
}
