// Basic example: multiline string with triple quotes.
// Multiline strings can be used anywhere a string is accepted.
// Indentation inside the triple-quoted block is neutralized.
// This workflow stays minimal while demonstrating the syntax.

provider ollama {
    driver: "ollama"
    models: ["qwen3.5:8b"]
}

agent greeting {
    model: ollama("qwen3.5:8b")

    // Leading indentation in this multiline string is neutralized.
    prompt: """
        You are a friendly assistant.
        Write a short welcome message.
        Keep it to one sentence.
    """

    output: string
}

output {
    greeting: agent.greeting
}
