provider openai {
    driver: "openai"
    endpoint: secrets.openai_endpoint
    api_key: secrets.openai_api_key
    models: [secrets.openai_model]
}

secrets {
    openai_endpoint: string
    openai_api_key: string
    openai_model: string
    fingerprint_salt: string
}

input {
    collection_id: string
    topic: string
    audience: string
}

agent announcement_writer {
    model: openai(secrets.openai_model)
    prompt: "Write a short 2-sentence announcement for {{ input.audience }} about {{ input.topic }}."
    output: {
        headline: string
        summary: string
    }
}

agent content_fingerprint {
    model: openai(secrets.openai_model)
    tools: [
        tool.content_fingerprint(
            collection_id: input.collection_id,
            signing_salt: secrets.fingerprint_salt
        )
    ]
    prompt: """
        Use content_fingerprint exactly once.

        Generate only these tool input fields:
        - headline: {{ agent.announcement_writer.headline }}
        - summary: {{ agent.announcement_writer.summary }}
    """
    output: {
        fingerprint_sha256: string
        short_code: string
    }
}

output {
    announcement: agent.announcement_writer
    content_fingerprint: agent.content_fingerprint
}
