{
  "name": "@superwire/ffi-js-bridge",
  "version": "0.1.0",
  "private": true,
  "description": "TypeScript bridge for superwire Rust FFI runtime",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "commonjs",
  "files": [
    "dist/",
    "native/"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:native": "npm run build && node ./dist/scripts/build-native.js",
    "postinstall": "npm run build:native",
    "check": "tsc -p tsconfig.json --noEmit",
    "example:simple": "npm run build:native && node ./dist/examples/simple.js"
  },
  "dependencies": {
    "ffi-rs": "^1.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.17.57",
    "typescript": "^5.8.3"
  }
}
