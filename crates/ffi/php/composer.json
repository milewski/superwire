{
  "name": "engine-ai/ffi-php-bridge",
  "description": "PHP bridge for the engine-ai Rust FFI runtime",
  "type": "library",
  "license": "MIT",
  "keywords": [
    "engine-ai",
    "ffi",
    "php",
    "workflow",
    "extension"
  ],
  "homepage": "https://github.com/engine-ai/engine-ai",
  "support": {
    "issues": "https://github.com/engine-ai/engine-ai/issues",
    "source": "https://github.com/engine-ai/engine-ai"
  },
  "require": {
    "php": "^8.2",
    "ext-json": "*"
  },
  "suggest": {
    "ext-engine_ai_ffi": "Native extension installed by composer scripts"
  },
  "autoload": {
    "psr-4": {
      "EngineAi\\Ffi\\": "src/"
    },
    "classmap": [
      "src/"
    ],
    "files": [
      "src/Protocol/constants.php",
      "src/Bridge/functions.php"
    ]
  },
  "scripts": {
    "lint": "php scripts/lint.php",
    "build-native": "php scripts/build-native.php",
    "package-prebuilt": "php scripts/package-prebuilt.php",
    "install-native": "php scripts/install-native.php",
    "post-install-cmd": [
      "@install-native"
    ],
    "post-update-cmd": [
      "@install-native"
    ]
  },
  "config": {
    "sort-packages": true
  },
  "extra": {
    "branch-alias": {
      "dev-main": "0.1.x-dev"
    }
  }
}
